********************************************************************
* draw.a - the camera, the display list and the sprite records.
*
*   Every pass each character puts one entry in the display list.  The
*   list is sorted nearest first (sprite 0 is drawn on top), and each
*   entry's frame expands into one 32x32 record per cell (frames.bin).
*   The shadows go after every character, so nothing stands behind its
*   own shadow.  One SS.SprPush sends the records used this pass or last.
********************************************************************

CTL.Spr             equ       %00000001+CLUT.Spr*2    enabled, the sprite CLUT, 32x32
CamLead             equ       144                 the camera keeps him 0.45 of the way across

CamInit             ldd       #0
                    std       <camf
                    std       <cam
                    rts

********************************************************************
* Camera - follow the hero rightward (it never pans back: brawler.js),
*   easing in by 1/8 of the gap a pass; then the three maps' scroll:
*   street 1x, hill 1/2, sky 1/4.
********************************************************************
Camera              tst       <lock               locked: it holds
                    beq       cm0
                    rts
cm0                 ldd       <hx
                    subd      #CamLead*16
                    bcc       cm1
                    ldd       #0
cm1                 cmpd      cammax,u            (the stage's right-hand stop)
                    bls       cm2
                    ldd       cammax,u
cm2                 subd      <camf
                    bls       cm5                 never back
                    lsra
                    rorb
                    lsra
                    rorb
                    lsra
                    rorb
                    bne       cm4
                    ldb       #1
cm4                 addd      <camf
                    std       <camf
cm5                 ldd       <camf
                    lsra
                    rorb
                    lsra
                    rorb
                    lsra
                    rorb
                    lsra
                    rorb
                    std       <cam
                    rts

********************************************************************
* Draw - the display list, the records, one push, the maps' scroll.
*   Exit: carry = error in B
********************************************************************
Draw                lbsr      ShakeXY
                    clr       <dln
                    lda       <phase
* the hero: on alternate beats while he's untouchable only his shadow
                    cmpa      #PH.Intro           the opening: rising from the grave
                    bne       dwh
                    lbsr      IntroFrame
                    bcs       dw0a                still underground
                    std       <efrm
                    lda       #CTL.Spr
                    bra       dw0
dwh                 lbsr      HeroFrame
                    std       <efrm
                    lda       #CTL.Spr
                    ldb       <hinv
                    bitb      #4
                    beq       dw0
                    clra
dw0                 sta       <ectl
                    lda       #1
                    sta       <eshk
                    sta       <ekey
                    ldd       <hx
                    std       <ex
                    ldd       <hz
                    std       <ez
                    ldd       <hh
                    std       <eh
                    lbsr      Ent
                    lbsr      DrawDHat            the death scene's hat (death.a)
* the posse, loose skulls, bullets, particles (enemy.a)
dw0a
                    lbsr      DrawEn
                    lbsr      DrawSl
                    lbsr      DrawEb
                    lbsr      DrawPt
                    lbsr      DrawPick
                    lda       sflags,u            Boot Hill: Ringo's grave; Main Street: a tumbleweed
                    bita      #SG.Intro
                    beq       dwg1
                    lbsr      DrawGrave
dwg1                lbsr      DrawTw
                    lbsr      DrawCl
                    lbsr      SortDL
* the HUD, titles and popups over everything, then everything else
*   nearest first
                    leay      recs,u
                    lbsr      DrawTop
                    clr       <tmpi
dw1                 ldb       <tmpi
                    cmpb      <dln
                    bhs       dw2
                    leax      dlord,u
                    lda       b,x
                    ldb       #DL.Size
                    mul
                    leax      dl,u
                    leax      d,x
                    lda       DL.Ctl,x
                    beq       dw1n
                    sta       <bctl
                    ldd       DL.X,x
                    std       <bcx
                    ldd       DL.Y,x
                    std       <bcy
                    ldd       DL.Frm,x
                    lbsr      BuildChar
dw1n                inc       <tmpi
                    bra       dw1
* then the shadows, behind it all
dw2                 leax      dl,u
                    lda       <dln
                    sta       <tmpn
                    beq       dw3
dw2a                lda       DL.Shk,x
                    beq       dw2n
                    pshs      x
                    ldd       DL.Shy,x
                    std       <bcy
                    ldd       DL.X,x
                    std       <bcx
                    lda       #CTL.Spr
                    sta       <bctl
                    lda       DL.Shk,x
                    ldx       #FX.shadow
                    cmpa      #1
                    beq       dw2b
                    ldx       #FX.shadowS
dw2b                tfr       x,d
                    lbsr      BuildChar
                    puls      x
dw2n                leax      DL.Size,x
                    dec       <tmpn
                    bne       dw2a
* switch off what was used last pass and not this one, and push them all
dw3                 tfr       y,d
                    pshs      u
                    subd      ,s++
                    subd      #recs
                    lsra
                    rorb
                    lsra
                    rorb
                    lsra
                    rorb                          B = records used
                    stb       <tmpn
dw4                 cmpb      <nrec
                    bhs       dw5
                    clr       ,y
                    leay      8,y
                    incb
                    bra       dw4
dw5                 lda       <tmpn               push max(this pass, last pass)
                    ldb       <nrec
                    sta       <nrec
                    pshs      a
                    cmpb      ,s+
                    bhs       dw6
                    tfr       a,b
dw6                 clra
                    tstb
                    beq       dw7
                    ldy       #0
                    lbsr      SprPush
                    bcs       dwx
dw7                 lbra      MapScrl
dwx                 rts

********************************************************************
* Ent - one thing into the display list: ex, ez, eh (12.4), efrm, ectl,
*   eshk, ekey.  Screen x = x - camera, y = FLOOR.Y + z - h, both
*   shaken; the shadow at h = 0.  Things well off the screen are left
*   out.  Sort key: z * 2 + ekey (0 = behind characters at that depth,
*   1 = a character), or $FF for ekey $FF (on top), 0 for ekey $FE (flat
*   on the ground, in front of only the shadows).
********************************************************************
Ent                 lda       <dln
                    cmpa      #NDL
                    bhs       entx
                    ldd       <ex
                    lbsr      Asr4
                    subd      <cam
                    addd      <shx
                    cmpd      #-48
                    blt       entx
                    cmpd      #368
                    bgt       entx
                    pshs      d
                    lda       <dln
                    ldb       #DL.Size
                    mul
                    leay      dl,u
                    leay      d,y
                    puls      d
                    std       DL.X,y
                    ldd       <efrm
                    std       DL.Frm,y
                    lda       <ectl
                    sta       DL.Ctl,y
                    lda       <eshk
                    sta       DL.Shk,y
                    ldd       <ez                 z in pixels
                    lbsr      Asr4
                    std       <tmp
                    lda       <ekey               the sort key
                    cmpa      #$FF
                    beq       en1
                    cmpa      #$FE                flat on the ground: behind everything
                    bne       en0
                    clra
                    bra       en1
en0                 lda       <tmp+1
                    lsla
                    adda      <ekey
en1                 ldb       <dln
                    leax      dlkey,u
                    sta       b,x
                    leax      dlord,u
                    stb       b,x
                    ldd       <tmp                the shadow's y, then the feet's
                    addd      #FLOOR.Y
                    subd      <shy
                    std       DL.Shy,y
                    ldd       <eh
                    lbsr      Asr4
                    std       <tmp
                    ldd       DL.Shy,y
                    subd      <tmp
                    std       DL.Y,y
                    inc       <dln
entx                rts

* SortDL - dlord, nearest (biggest key) first: an insertion sort of the
*   entry numbers, stable, so equal keys keep the order they came in
SortDL              lda       <dln
                    cmpa      #2
                    blo       srx
                    leax      dlord,u
                    leay      dlkey,u
                    ldb       #1                  i
sr1                 stb       <tmpi
                    lda       b,x                 v = ord[i], k = key[v]
                    sta       <tmpf
                    lda       a,y
                    sta       <tmpk
                    decb                          j = i - 1
sr2                 bmi       sr3
                    lda       b,x
                    lda       a,y
                    cmpa      <tmpk
                    bhs       sr3                 key[ord[j]] >= k: it goes after
                    lda       b,x                 ord[j+1] = ord[j]
                    incb
                    sta       b,x
                    subb      #2                  j--
                    bra       sr2
sr3                 incb
                    lda       <tmpf
                    sta       b,x
                    ldb       <tmpi
                    incb
                    cmpb      <dln
                    blo       sr1
srx                 rts

* ShakeXY - this pass's offsets from the shake: x -s..s, y 0..s (s in pixels)
ShakeXY             ldd       #0
                    std       <shx
                    std       <shy
                    lda       <shake
                    lsra
                    beq       shk9
                    sta       <tmpn
                    lsla
                    inca
                    lbsr      RandN
                    suba      <tmpn
                    tfr       a,b
                    sex
                    std       <shx
                    lda       <tmpn
                    inca
                    lbsr      RandN
                    tfr       a,b
                    clra
                    std       <shy
shk9                rts

* MapScrl - the three maps follow the camera, shaken with the sprites.
*   Exit: carry = error in B
MapScrl             ldd       <cam
                    bsr       msh
                    ldy       #2
                    lbsr      Scrl
                    bcs       msx
                    ldd       <cam
                    lsra
                    rorb
                    bsr       msh
                    ldy       #1
                    lbsr      Scrl
                    bcs       msx
                    ldd       <cam
                    lsra
                    rorb
                    lsra
                    rorb
                    bsr       msh
                    ldy       #0
                    lbsr      Scrl
msx                 rts
msh                 subd      <shx                X = D - the shake, not below 0
                    bpl       msh1
                    ldd       #0
msh1                tfr       d,x
                    rts

********************************************************************
* BuildChar - one frame as 32x32 sprite records.
*   Entry: Y = the next free record, D = the frame, bcx/bcy = the feet
*   on screen, bctl = the CTRL byte.  Exit: Y = the next free record.
*   Each cell (frames.bin: count, then dx, dy, cell number) becomes:
*     ADDR = sprbase + cell * 1024,  X = feet x + dx + 32,  Y = feet y + dy + 32
*   (the visible screen starts at 32,32).  Stops when the records run out.
********************************************************************
BuildChar           leax      frames,u
                    lslb
                    rola                          D = frame * 2
                    addd      #2
                    ldd       d,x                 the frame's offset in frames.bin
                    leax      d,x
                    lda       ,x+
                    sta       <bcn
                    beq       bc9
bc1                 cmpy      <recend
                    bhs       bc9
                    lda       <bctl
                    sta       ,y                  CTRL
                    ldd       2,x                 the cell number
                    lslb
                    rola
                    lslb
                    rola                          cell * 4 = address bits 23:8
                    addb      <sprbase+1
                    adca      <sprbase
                    std       1,y                 ADDR hi, mid
                    clr       3,y                 ADDR lo
                    ldb       ,x                  dx
                    sex
                    addd      <bcx
                    addd      #32
                    std       4,y
                    ldb       1,x                 dy
                    sex
                    addd      <bcy
                    addd      #32
                    std       6,y
                    leax      4,x
                    leay      8,y
                    dec       <bcn
                    bne       bc1
bc9                 rts

* BuildRaw - one cell as one record: D = the cell, bcx/bcy = its
*   top-left on the screen, bctl = the CTRL byte.  Y = the record -> the next
BuildRaw            cmpy      <recend
                    bhs       rw9
                    lslb
                    rola
                    lslb
                    rola                          cell * 4 = address bits 23:8
                    addb      <sprbase+1
                    adca      <sprbase
                    std       1,y
                    clr       3,y
                    lda       <bctl
                    sta       ,y
                    ldd       <bcx
                    addd      #32
                    std       4,y
                    ldd       <bcy
                    addd      #32
                    std       6,y
                    leay      8,y
rw9                 rts

ClearRecs           leax      recs,u
                    ldy       #NRecs*8
cr1                 clr       ,x+
                    leay      -1,y
                    bne       cr1
                    rts

PushRecs            ldy       #0
                    ldd       #NRecs
* SprPush - Y = first record, D = count.  Exit: carry = error in B
SprPush             pshs      u
                    tfr       d,u
                    clra
                    ldb       #SS.SprPush
                    os9       I$SetStt
                    puls      u,pc
