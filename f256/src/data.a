********************************************************************
* data.a - the data area.  U = DP = its start; the direct page first,
*   then the larger tables, then the stack.  Cleared at start-up.
********************************************************************

* sizes
NRecs               equ       128                 sprite records we own (SS.SprReg): all of them
NEn                 equ       6                   enemies at once (Main Street's last wave is six)
NSl                 equ       4                   loose skulls
NEb                 equ       6                   the posse's bullets in the air
NPt                 equ       20                  particles: sparks, dust, bones
NDL                 equ       1+NEn+NSl+NEb+NPt   display list entries a pass
NTilBlk             equ       (TIL.Size+$1FFF)/$2000
NSprBlk             equ       (SPR.Size+$1FFF)/$2000
NMapBlk             equ       (MAP.Size+$1FFF)/$2000

* a display list entry: one thing drawn (its sort key is in dlkey)
DL.Ctl              equ       0                   sprite CTRL byte (enable, CLUT); 0 = only its shadow
DL.Frm              equ       1                   frame number (mirrored already applied)
DL.X                equ       3                   screen x of the feet
DL.Y                equ       5                   screen y of the feet
DL.Shy              equ       7                   screen y of its shadow
DL.Shk              equ       9                   its shadow: 0 none, 1 big, 2 small
DL.Size             equ       10

* an enemy (positions and velocities 12.4, like the hero's)
EN.St               equ       0                   state (ES.*), 0 = a free slot
EN.T                equ       1                   passes in the state (stops at 255)
EN.X                equ       2
EN.Z                equ       4
EN.H                equ       6
EN.VX               equ       8
EN.VZ               equ       10
EN.VH               equ       12
EN.Fc               equ       14                  0 = facing right, 1 = left
EN.Hp               equ       15                  health (signed)
EN.Am               equ       16                  rounds left in the six-shooter
EN.Cd               equ       17                  passes before it may attack again
EN.Fl               equ       18                  passes of hit flash left
EN.Sk               equ       19                  1 = its skull is on
EN.An               equ       20                  the animation clock
EN.Hit              equ       21                  the hero's attack that last hit it (hatk)
EN.Id               equ       22                  its slot number + 1 (a skull's owner)
EN.Ty               equ       23                  what it is: TY.Skel, TY.Dillo
EN.Sd               equ       24                  the side it came in from: 1 right, -1 left
EN.Nm               equ       25                  a skeleton's name (DeadNames)
EN.Size             equ       26

TY.Skel             equ       0
TY.Dillo            equ       1
TY.Boss             equ       2
TY.Coy              equ       3                   the mangy coyote (Main Street)
TY.SkelW            equ       4                   (a wave's code only: a skeleton that walks in, not rises)

* the hero's weapon (hwep)
WP.None             equ       0
WP.Whip             equ       1
WP.Gun              equ       2

* a loose skull: knocked off, on the ground, or kicked down the lane
SL.St               equ       0                   SL.Fly, SL.Grnd, SL.Kick; 0 = free
SL.X                equ       1
SL.Z                equ       3
SL.H                equ       5
SL.VX               equ       7
SL.VH               equ       9
SL.Own              equ       11                  its body's EN.Id, 0 = nobody's
SL.T                equ       12                  passes on the ground with no owner
SL.Hit              equ       13                  the hero's attack that last kicked it
SL.Size             equ       14

* one of the posse's bullets (flies at BulH, straight down the lane)
EB.St               equ       0                   1 = flying
EB.X                equ       1
EB.Z                equ       3
EB.VX               equ       5
EB.Size             equ       7

* a particle
PT.L                equ       0                   passes to live, 0 = free
PT.K                equ       1                   kind (PK.*)
PT.F                equ       2                   frame
PT.X                equ       4
PT.Z                equ       6
PT.H                equ       8
PT.VX               equ       10
PT.VH               equ       12
PT.Size             equ       14

* held-input bits (INP); the game edge-detects them into IPRESS
IN.Left             equ       %00000001
IN.Right            equ       %00000010
IN.Up               equ       %00000100
IN.Down             equ       %00001000
IN.Jump             equ       %00010000
IN.Kick             equ       %00100000
IN.Side             equ       %01000000
IN.Taunt            equ       %10000000

* ---------------------------------------------------------------- direct page
dbase               rmb       2                   the data area (U), for after calls that return U
sigcode             rmb       1                   abort/interrupt signal (0 = none)
paused              rmb       1                   1 = our terminal is in the background
wsigok              rmb       1                   1 = SS.WSig registered
mcrlo               rmb       1                   display mode on entry, put back on exit
mcrhi               rmb       1
gfxon               rmb       1                   1 = our display mode is on
tilblk              rmb       1                   first block of each asset (0 = none)
sprblk              rmb       1
mapblk              rmb       1
regd                rmb       1                   1 = the sprite table is registered
sprbase             rmb       3                   physical address of sprblk: hi, mid, lo
fpath               rmb       1                   LoadFile: the path
lblk                rmb       1                   LoadFile: current block
lcnt                rmb       1                   LoadFile: blocks left
loff                rmb       2                   LoadFile: offset in the current block
lmap                rmb       2                   LoadFile: where the block is mapped
tsn                 rmb       1                   tile set counter
* input
demo                rmb       1                   1 = the demo script drives the hero (tsk d)
bot                 rmb       1                   1 = the autopilot drives him (tsk b)
god                 rmb       1                   1 = nothing hurts him (tsk g)
skipb               rmb       1                   1 = start at Two-Bit (tsk k)
botarg              rmb       1                   1 = tsk b: the autopilot plays every game
attract             rmb       1                   1 = this game's the attract mode
attt                rmb       2                   passes of the attract mode
klast               rmb       1                   the keyboard alone, last pass (not the bot's)
kpress              rmb       1                   the keyboard's new presses
camdir              rmb       1                   the title's camera: 0 right, 1 left
hisc                rmb       4                   the high score (BCD)
* sound (snd.a)
musblk              rmb       1                   the first music block (a block a song)
msong               rmb       1                   the song playing ($FF = none)
mwait               rmb       1                   frames to its next record
mptr                rmb       2                   the next record
mmap                rmb       2                   where its block is mapped (0 = not)
mcnt                rmb       1
mbn                 rmb       1                   bytes in this frame's MIDI buffer
mipath              rmb       1                   /mi's path (MidiPath builds)
msnd                rmb       1                   1 = no sound effects
bott                rmb       1                   autopilot: passes before its next kick
binp                rmb       1                   autopilot: the input it builds
bnear               rmb       2                   autopilot: the enemy it's after
bbest               rmb       2                   autopilot: its distance
dptr                rmb       2                   demo: the script entry
dleft               rmb       1                   demo: ticks left in the entry
inp                 rmb       1                   held now (IN.*)
ilast               rmb       1                   held last pass
ipress              rmb       1                   new presses this pass
qkey                rmb       1                   1 = Q pressed
* time, camera, weather
ticks               rmb       2                   passes since start
camf                rmb       2                   camera x, 12.4
cam                 rmb       2                   camera x, pixels
lflash              rmb       1                   lightning: passes left
rnd                 rmb       2                   the random number generator
hitstop             rmb       1                   passes the action is frozen (a hit landing)
shake               rmb       1                   screen shake, half pixels; runs down a half a pass
shx                 rmb       2                   this pass's shake: x (signed)
shy                 rmb       2                   and y (0 up to the shake)
lock                rmb       1                   1 = the screen is locked: a wave is on (the camera holds)
* the stage (stage.a)
phase               rmb       1                   PH.*
phaset              rmb       2                   passes in the phase
titlet              rmb       2                   passes since the stage began (the title shows 3.2 s)
wavei               rmb       1                   the next wave (or the one on)
got                 rmb       1                   passes of "GO >>" left
eleft               rmb       1                   enemies still in the fight this pass (not KO'd)
attackers           rmb       1                   dillos winding up or striking (two at most close in)
score               rmb       4                   BCD, eight digits
combo               rmb       1                   hits in a row
combot              rmb       1                   passes before the combo lapses
scw                 rmb       2                   AddScore: the points
scn                 rmb       1                   AddScore: a counter, then a BCD byte
scd                 rmb       1                   AddScore: a digit
bcd                 rmb       2                   AddScore: what's left to convert
* the HUD (hud.a): what each part shows now, to redraw only on a change
hudsc               rmb       4                   the score shown
hudhp               rmb       1                   his health shown
hudwp               rmb       1                   the weapon shown (type << 4 + rounds)
hudeid              rmb       1                   the enemy shown (its id, 0 = nobody)
hudehp              rmb       1                   its health shown
hudcb               rmb       1                   the combo shown (0 = none)
hudnm               rmb       1                   1 = his name's still to draw
hudhi               rmb       1                   1 = the title's high score to draw in the strip
hudclr              rmb       1                   1 = the strip to clear (after the title)
hmapd               rmb       1                   1 = the HUD block is mapped this pass
lhit                rmb       1                   the enemy last hit (its id)
lhitt               rmb       1                   passes its bar still shows
dmap                rmb       2                   where a dynamic block is mapped
hcnt                rmb       1                   counters
hcn2                rmb       1
hcol                rmb       1                   Text: the fill colour
hx0                 rmb       1                   Text, Bar: x
hy0                 rmb       1                   and the row
hbar                rmb       1                   Bar: how full (px)
hstr                rmb       2                   Text: the next character
hptr                rmb       2                   Text, Bar: the column pointer
nptr                rmb       2                   Text: the next character's column
nx0                 rmb       1
popn                rmb       1                   the last popup cell used
pux                 rmb       2                   a new popup: x in the level (px)
puy                 rmb       2                   its screen y
puf                 rmb       2                   its frame or cell
puk                 rmb       1                   0 = a word (TX), 1 = points (a dynamic cell)
pul                 rmb       1                   its life
puw                 rmb       1                   points: the text's width
hatop               rmb       1                   the opening: 1 = the hat's on his head
* Two-Bit (boss.a)
bslot               rmb       2                   his enemy slot (0 = none yet)
bst                 rmb       1                   what he's doing (BS.*)
bn                  rmb       1                   his moves so far (every third a dig)
bsaid               rmb       1                   1 = he's had his say
bsum                rmb       1                   1 = he's raised the dead
bhit                rmb       1                   1 = this swing has hit
bmx                 rmb       2                   the mound, when he's under the street (12.4)
bmz                 rmb       2
hwep                rmb       1                   his weapon (WP.*)
hammo               rmb       1                   its rounds (or the whip's lashes)
nbolt               rmb       2                   passes to the next lightning
* the hero (positions and velocities 12.4)
hx                  rmb       2                   x in the level
hz                  rmb       2                   depth into the street, 0 = back
hh                  rmb       2                   height above the floor
hvx                 rmb       2
hvz                 rmb       2
hvh                 rmb       2
hface               rmb       1                   0 = right, 1 = left
hst                 rmb       1                   state (ST.*)
ht                  rmb       1                   passes in the state (stops at 255)
hstep               rmb       1                   the snap-kick combo step, 1-3
hqd                 rmb       1                   1 = a kick queued during a snap kick
hchain              rmb       1                   passes left to chain the next snap kick
hdx                 rmb       1                   -1, 0, 1 this pass
hdz                 rmb       1
hback               rmb       1                   1 = pressing away from his facing
hdesc               rmb       2                   the animation playing (descriptor), 0 = restart
hfr                 rmb       1                   its frame
hft                 rmb       1                   passes into the frame
hhp                 rmb       1                   health (signed)
hlives              rmb       1                   lives (hats)
hinv                rmb       1                   passes he can't be hurt
hatk                rmb       1                   the attack: a new number each state, so a kick hits each foe once
* combat (enemy.a)
ecur                rmb       2                   the enemy being updated
eloop               rmb       1                   loop counters, one per loop that can nest
aloop               rmb       1
sloop               rmb       1
bloop               rmb       1
ploop               rmb       1
dloop               rmb       1
kcnt                rmb       1
hdir                rmb       1                   a hit's direction: 0 right, 1 left
dmg                 rmb       1
knock               rmb       1
sx                  rmb       2                   where a spark, a puff or a particle goes (12.4)
sz                  rmb       2
sh                  rmb       2
tdx                 rmb       2                   deltas (12.4)
tdz                 rmb       2
tcap                rmb       2                   Toward: the speed limit
hxp                 rmb       2                   the hero in pixels: x, height
hhpx                rmb       2
bx0                 rmb       2                   the hero's attack box this pass, pixels
bx1                 rmb       2
bh0                 rmb       2
bh1                 rmb       2
* drawing
dln                 rmb       1                   display list entries this pass
ex                  rmb       2                   Ent: the thing's x, z, h (12.4)
ez                  rmb       2
eh                  rmb       2
efrm                rmb       2                   its frame
ectl                rmb       1                   its CTRL byte
eshk                rmb       1                   its shadow (DL.Shk)
ekey                rmb       1                   0 = behind characters at its depth, 1 = a character, $FF = on top
tmpi                rmb       1
tmpk                rmb       1
nrec                rmb       1                   sprite records used last pass
bcx                 rmb       2                   BuildChar: the feet, screen x
bcy                 rmb       2                   and y
bctl                rmb       1                   the CTRL byte
bcn                 rmb       1                   cells left in the frame
recend              rmb       2                   the end of recs
tmpn                rmb       1
tmpf                rmb       1
tmp                 rmb       2
dpend               equ       .
                    ifgt      dpend-256
                    error     "the direct page is full: move a variable below dpend"
                    endc

* ---------------------------------------------------------------- the rest
tmrec               rmb       12                  SS.TmSet record (reached by leax tmrec,u only)
* the stage (stage.a): reached as name,u (the direct page is full)
stgn                rmb       1                   0 Boot Hill, 1 Main Street
stgp                rmb       2                   its record in StgTab
levw                rmb       2                   its width, px
cammax              rmb       2                   the camera's right-hand stop (12.4)
hxmax               rmb       2                   his right-hand stop (12.4)
sflags              rmb       1                   SF.* : the opening, lightning, dusk
nwaves              rmb       1                   its waves
duskblk             rmb       1                   the dusk CLUTs' two blocks
dstep               rmb       1                   the dusk CLUT showing (0-12)
dclk                rmb       1                   passes to the next dusk step
twst                rmb       1                   the tumbleweed: 1 = rolling
twx                 rmb       2                   x, z, h, vx, vh (12.4)
twz                 rmb       2
twh                 rmb       2
twvx                rmb       2
twvh                rmb       2
twt                 rmb       2                   passes before the next one
stgarg              rmb       1                   tsk m: start at Main Street
ptnx                rmb       2                   NewPt: where the next search starts (0 = the first)
ptend               rmb       2                   the end of the particle table (set at start-up)
gdown               rmb       1                   1 = Two-Bit's down: his gang follows, one a pass
ptfull              rmb       1                   1 = NewPt found the particles full this pass
recs                rmb       NRecs*8             our sprite table, registered with the driver
dl                  rmb       NDL*DL.Size         the display list
dlkey               rmb       NDL                 each entry's sort key: bigger = nearer = drawn on top
dlord               rmb       NDL                 the entries, nearest first
en                  rmb       NEn*EN.Size         the enemies
sl                  rmb       NSl*SL.Size         loose skulls
eb                  rmb       NEb*EB.Size         the posse's bullets
pu                  rmb       NPu*PU.Size         popups
br                  rmb       NBr*BR.Size         barrels
it                  rmb       NIt*IT.Size         items lying about
hb                  rmb       NHb*HB.Size         his bullets
cl                  rmb       NCl*CL.Size         Two-Bit's clods
hbuf                rmb       24                  text being built
pend                rmb       NPend*PN.Size       queued MIDI: note-offs, delayed notes
mbuf                rmb       NMBuf               this frame's MIDI
pt                  rmb       NPt*PT.Size         particles
frames              rmb       FRM.Size            frames.bin
clutbuf             rmb       1024                sprite CLUT, then the all-white hit-flash CLUT
tclut               rmb       1024                the tile CLUT
fclut               rmb       1024                the tile CLUT, lightning-lit
StkBase             equ       .
                    rmb       512                 stack
size                equ       .
