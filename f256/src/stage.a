********************************************************************
* stage.a - the stage: waves, the screen lock, GO, the phases (play,
*   clear, the end, game over), the score, and starting over.
*   brawler.js loadStage, startWave, updateWaves, stageClear, simulate.
********************************************************************

* phases
PH.Play             equ       0
PH.Clear            equ       1                   the stage is won: a taunt, the title
PH.End              equ       2                   TO BE CONTINUED... (Main Street comes in sprint 4)
PH.Over             equ       3                   game over

TitleLen              equ       192                 the stage title shows 3.2 s
GoLen               equ       180                 "GO >>" blinks 3 s after a wave
ClearT              equ       210                 3.5 s of the clear before the end
WaitT               equ       120                 the end and game over take a jump after 2 s
ComboLen              equ       84                  1.4 s to land the next hit of a combo

********************************************************************
* GameInit - a new game: everything cleared, the hero at the start
********************************************************************
GameInit            ldd       #0
                    std       <attt
                    lbsr      CombatInit          health, lives
                    ldd       <ticks              a different fight each time
                    eora      <rnd
                    eorb      <rnd+1
                    bne       gi2
                    incb
gi2                 std       <rnd
                    lbsr      HudInit
                    clr       <hwep
                    clr       <hammo
                    ldd       #0
                    std       <score
                    std       <score+2
                    clr       <combo
                    clr       <combot
                    lda       stgarg,u            (tsk m: Main Street first)
* StageInit - A = the stage: its art loaded, its street set up, its music.
*   The hero keeps his health, lives, score.
StageInit           bsr       StageSet
                    lbcs      Fail
                    bra       si00

* StageSet - A = the stage: its record, its stops, and its art (unless it's
*   the art already loaded).  The title uses it for Boot Hill's backdrop.
*   Exit: carry = error in B
StageSet            sta       stgn,u
                    ldb       #SR.Size            its record
                    mul
                    leax      StgTab,pcr
                    leax      d,x
                    stx       stgp,u
                    ldd       SR.W,x              its width, and the stops it sets: at most MaxW,
                    cmpd      #MaxW               the most a 12.4 position holds signed (2047 px).
                    bls       ss0x                Main Street is 2400 px wide, but its last wave
                    ldd       #MaxW               is at 1660 and nothing goes past ~2000 in play
ss0x                std       levw,u
                    subd      #320
                    lbsr      To124
                    std       cammax,u
                    ldd       levw,u
                    subd      #10
                    lbsr      To124
                    std       hxmax,u
                    lda       SR.Flags,x
                    sta       sflags,u
                    lda       SR.NWv,x
                    sta       nwaves,u
                    lda       stgn,u              already loaded (the title's Boot Hill)?
                    cmpa      ldstg,u
                    beq       ss9x
                    lbsr      LoadStage           the tiles, maps and its own sprites
                    bcs       ss8x
                    lda       stgn,u
                    sta       ldstg,u
ss9x                andcc     #$FE
ss8x                rts
si00                leax      en,u                every table: enemies, skulls, bullets, popups, particles
                    ldy       #fridx-en
gi1                 clr       ,x+
                    leay      -1,y
                    bne       gi1
                    leax      en,u                each slot's id again (the clear took them: no HUD bars)
                    lda       #1
gi1a                sta       EN.Id,x
                    leax      EN.Size,x
                    inca
                    cmpa      #NEn
                    bls       gi1a
                    lbsr      HeroInit
                    lbsr      CamInit
                    lbsr      PickInit
                    clr       riding,u            not riding (the core tests these; ride.a sets them)
                    clr       hmount,u
                    clr       hremount,u
                    clr       rtread,u
                    clr       lon,u
                    lbsr      SignInit            (Ghost Town's signs: tskgt)
                    lbsr      RideInit            (the Cattle Drive's ride: tskcd)
                    ldd       #0
                    std       <phaset
                    std       <titlet
                    clr       <phase
                    clr       <wavei
                    clr       <got
                    clr       <lock
                    clr       <hitstop
                    clr       <bslot
                    clr       <bslot+1
                    clr       <shake
                    clr       twst,u
                    clr       gdown,u
                    clr       dstep,u
                    ldd       #240                the first tumbleweed after 4 s
                    std       twt,u
                    ldd       #420                the first bolt after 7 s
                    std       <nbolt
                    ldx       stgp,u              its music (after the clear above: the MIDI buffer's in it)
                    lda       SR.Mus,x
                    lbsr      Music
                    tst       <skipb              (tsk k: straight to the stage's boss)
                    bne       gi4
                    lda       sflags,u
                    bita      #SG.Intro
                    beq       gi3
                    lbra      IntroInit           Boot Hill begins in the grave
gi4                 clr       riding,u            (and no ride: on foot at the corral)
                    clr       hmount,u
                    clr       rtread,u
                    lda       nwaves,u            the last wave: the boss's
                    deca
                    sta       <wavei
                    lda       #1
                    sta       <hatop
                    lbsr      WaveRec
                    ldd       ,x                  its spot
                    std       <cam
                    pshs      d
                    lbsr      To124
                    std       <camf
                    puls      d
                    addd      #80
                    lbsr      To124
                    std       <hx
                    ldd       #40*16
                    std       <hz
gi3                 rts

* LoadStage - stage's art, with nothing on the screen while it loads:
*   the maps and sprites off, the tiles, maps and sprite overlay read in,
*   the tile sets and maps set up again.  Exit: carry = error in B
LoadStage           lbsr      MapsOff
                    lbsr      ClearRecs
                    lbsr      PushRecs
                    ldx       stgp,u
                    ldd       SR.Files,x          its three file names
                    leay      StgTab,pcr
                    leax      d,y
                    pshs      x
                    lda       <tilblk             tiles_<s>.bin
                    ldb       #NTilBlk
                    ldy       #0
                    lbsr      LoadFile
                    puls      x
                    bcs       ls9
                    bsr       NextName
                    pshs      x
                    lda       <mapblk             maps_<s>.bin
                    ldb       #NMapBlk
                    ldy       #0
                    lbsr      LoadFile
                    puls      x
                    bcs       ls9
                    bsr       NextName
                    pshs      x
                    lda       <sprblk             spr_<s>.bin, at the overlay's cells
                    adda      #SPR.Base/8
                    ldb       #NOvlBlk
                    ldy       #0
                    lbsr      LoadFile
                    puls      x
                    bcs       ls9
                    bsr       NextName
                    pshs      x
                    lda       frblk,u             frr_<s>.bin: its frames' records, after the shared ones
                    ldb       #1
                    ldy       #FRR.Sh
                    lbsr      LoadFile
                    puls      x
                    bcs       ls9
                    bsr       NextName            its code: the stage module (stgmod.a)
                    lbsr      StgLoad
                    bcs       ls9
                    lbra      StageGfx
ls9                 rts

* NextName - X = a $0D-terminated name: X = the one after it
NextName            lda       ,x+
                    cmpa      #$0D
                    bne       NextName
                    rts

********************************************************************
* The stages (brawler.js STAGES).  A record: width (px), the three maps'
*   widths and offsets, tile sets, flags, song, waves (count, table),
*   barrels (count, table), title frames (name, under it, the clear),
*   file names - the tables as offsets from StgTab.
********************************************************************
SR.W                equ       0
SR.Map              equ       2                   three of width, offset
SR.Sets             equ       14
SR.Flags            equ       15
SR.Mus              equ       16
SR.NWv              equ       17
SR.Waves            equ       18
SR.NBar             equ       20
SR.Bars             equ       21
SR.Name             equ       23
SR.Sub              equ       25
SR.Clr              equ       27
SR.Files            equ       29
SR.Size             equ       31
SG.Intro            equ       1                   the opening, the big title
SG.Light            equ       2                   lightning
SG.Dusk             equ       4                   night falls, wave by wave
SG.Ride             equ       8                   the ride: in the saddle, the trail scrolling (ride.a)
NOvlBlk             equ       (SPR.Ovl+7)/8
MaxW                equ       2032                (x 16 = 32512: under 32767, so signed compares work)

StgTab              fdb       BH.W                Boot Hill at midnight
                    fdb       BH.MAP0.W,BH.MAP0.Of,BH.MAP1.W,BH.MAP1.Of,BH.MAP2.W,BH.MAP2.Of
                    fcb       BH.TIL.Sets,SG.Intro+SG.Light,MU.boothill,5
                    fdb       WaveBH-StgTab
                    fcb       5
                    fdb       BarBH-StgTab
                    fdb       TX.boothill,TX.midnight,TX.clear
                    fdb       FileBH-StgTab
                    fdb       MS.W                Main Street at dusk
                    fdb       MS.MAP0.W,MS.MAP0.Of,MS.MAP1.W,MS.MAP1.Of,MS.MAP2.W,MS.MAP2.Of
                    fcb       MS.TIL.Sets,SG.Dusk,MU.boogie,6
                    fdb       WaveMS-StgTab
                    fcb       7
                    fdb       BarMS-StgTab
                    fdb       TX.mainst,TX.dusk,TX.msclear
                    fdb       FileMS-StgTab
                    fdb       GT.W                Ghost Town at moonrise: Doc Gila's
                    fdb       GT.MAP0.W,GT.MAP0.Of,GT.MAP1.W,GT.MAP1.Of,GT.MAP2.W,GT.MAP2.Of
                    fcb       GT.TIL.Sets,0,MU.deadman,6
                    fdb       WaveGT-StgTab
                    fcb       10
                    fdb       BarGT-StgTab
                    fdb       TX.ghostt,TX.moonrise,TX.gtclear
                    fdb       FileGT-StgTab
                    fdb       CD.W                the Cattle Drive at sunup: the ride, then Jack's corral
                    fdb       CD.MAP0.W,CD.MAP0.Of,CD.MAP1.W,CD.MAP1.Of,CD.MAP2.W,CD.MAP2.Of
                    fcb       CD.TIL.Sets,SG.Ride,MU.stampede,2
                    fdb       WaveCD-StgTab
                    fcb       4
                    fdb       BarCD-StgTab
                    fdb       TX.cattle,TX.sunup,TX.cdclear
                    fdb       FileCD-StgTab

FileBH              fcc       /tiles_bh.bin/
                    fcb       $0D
                    fcc       /maps_bh.bin/
                    fcb       $0D
                    fcc       /spr_bh.bin/
                    fcb       $0D
                    fcc       /frr_bh.bin/
                    fcb       $0D
                    fcb       $0D
FileCD              fcc       /tiles_cd.bin/
                    fcb       $0D
                    fcc       /maps_cd.bin/
                    fcb       $0D
                    fcc       /spr_cd.bin/
                    fcb       $0D
                    fcc       /frr_cd.bin/
                    fcb       $0D
                    fcc       /tskcd/
                    fcb       $0D
FileGT              fcc       /tiles_gt.bin/
                    fcb       $0D
                    fcc       /maps_gt.bin/
                    fcb       $0D
                    fcc       /spr_gt.bin/
                    fcb       $0D
                    fcc       /frr_gt.bin/
                    fcb       $0D
                    fcc       /tskgt/
                    fcb       $0D
FileMS              fcc       /tiles_ms.bin/
                    fcb       $0D
                    fcc       /maps_ms.bin/
                    fcb       $0D
                    fcc       /spr_ms.bin/
                    fcb       $0D
                    fcc       /frr_ms.bin/
                    fcb       $0D
                    fcc       /tskms/
                    fcb       $0D

********************************************************************
* Stage - one pass of the stage's clocks and phases (not while a hit
*   holds the action still).  The hero runs only in play.
********************************************************************
Stage               ldd       <phaset
                    addd      #1
                    std       <phaset
                    ldd       <titlet
                    cmpd      #$FFFF
                    beq       sg0
                    addd      #1
                    std       <titlet
sg0                 tst       <combot
                    beq       sg1
                    dec       <combot
sg1                 lda       <phase
                    cmpa      #PH.Title
                    lbeq      TitleStep
                    cmpa      #PH.Intro
                    lbeq      IntroStep
                    cmpa      #PH.Play
                    bne       sg2
                    lbsr      Hero
                    lbsr      Signs               Ghost Town's hanging signs (ghost.a)
                    lbsr      RideStep            the Cattle Drive's ride (ride.a)
                    tst       dying,u             (no wave while he's down)
                    bne       sgx
                    lbra      Waves
sg2                 cmpa      #PH.Clear
                    bne       sg4
                    lbsr      HeroPassive         the taunt, then standing
                    ldd       <phaset
                    cmpd      #ClearT
                    blo       sgx
                    lda       stgn,u             a stage won: on to the next (health back up 6,
                    cmpa      #3                  lives and score kept, the weapon left behind);
                    bhs       sg3                 the Cattle Drive's the last for now
                    lda       <hhp
                    adda      #6
                    cmpa      #MaxHp
                    ble       sg2a
                    lda       #MaxHp
sg2a                sta       <hhp
                    clr       <hwep
                    clr       <hammo
                    lda       stgn,u
                    inca
                    lbra      StageInit
sg3                 lbsr      HiScore             TO BE CONTINUED: the title theme again
                    lda       #MU.title
                    lbsr      Music
                    lda       #PH.End
                    bra       SetPh
sg4                 cmpa      #PH.Over            game over: he topples, lies there
                    bne       sg4a
                    lbsr      HeroPassive
sg4a                ldd       <phaset             the end, game over: jump to go again
                    cmpd      #WaitT
                    blo       sgx
                    lda       <ipress
                    bita      #IN.Jump
                    beq       sgx
                    lbra      TitleInit           back to the title
sgx                 rts

* SetPh - A = the new phase
SetPh               sta       <phase
                    ldd       #0
                    std       <phaset
                    rts

********************************************************************
* Waves - walk right to trigger the next gang; clear it to get GO >>
********************************************************************
Waves               tst       <got
                    beq       wv0
                    dec       <got
wv0                 tst       <lock
                    beq       wv2
                    tst       <eleft              the wave's on until they're all KO'd
                    bne       wvx
                    clr       <lock
                    inc       <wavei
                    lda       #GoLen
                    sta       <got
                    lda       #SF.Check
                    lbsr      Sfx
                    lda       <wavei
                    cmpa      nwaves,u
                    lbhs      StageClear
wvx                 rts
wv2                 lda       <wavei              the camera reaching the next wave's spot
                    cmpa      nwaves,u
                    bhs       wvx
                    bsr       WaveRec
                    ldd       <cam
                    addd      #1
                    cmpd      ,x
                    blo       wvx
* StartWave - X = the wave: the screen locks there and the gang comes
StartWave           ldd       ,x++
                    std       <cam                the camera holds at the wave's spot
                    lslb
                    rola
                    lslb
                    rola
                    lslb
                    rola
                    lslb
                    rola
                    std       <camf
                    lda       #1
                    sta       <lock
                    lda       ,x+                 how many ($FF = the boss)
                    cmpa      #$FF                (then which: 0 Two-Bit, 1 Big Shell Dillon, 2 Doc Gila)
                    bne       swb9
                    ldb       ,x
                    lbeq      StartBoss
                    decb
                    lbeq      StartDillon
                    decb
                    lbeq      StartGila
                    lbra      StartJack
swb9                equ       *
                    sta       <tmpn
                    clr       <tmpi               i
sw1                 pshs      x
                    lda       ,x                  the type
                    ldb       <tmpi
                    lbsr      Spawn
                    puls      x
                    leax      1,x
                    inc       <tmpi
                    dec       <tmpn
                    bne       sw1
                    rts

* WaveRec - X = wave number wavei's record
WaveRec             ldx       stgp,u              this stage's table
                    ldd       SR.Waves,x
                    leax      StgTab,pcr
                    leax      d,x
                    ldb       <wavei
                    beq       wr2
wr1                 lda       2,x                 skip a record: cam, count, types
                    cmpa      #$FF
                    bne       wr1a
                    clra
wr1a                leax      a,x
                    leax      3,x
                    decb
                    bne       wr1
wr2                 rts

* Spawn - A = the type, B = i: the i-th of a gang.  Skeletons rise out
*   of the ground on screen; the others walk in, even ones from the
*   right and odd ones from the left, two by two (brawler.js spawn)
Spawn               cmpa      #TY.Skel
                    lbeq      NewSkel
                    cmpa      #TY.SkelW
                    lbeq      NewSkelW
                    cmpa      #TY.Coy
                    lbeq      NewCoy
                    cmpa      #TY.Rat
                    lbeq      NewRat
                    lbra      NewDillo

* the waves: the camera's spot, how many, what (brawler.js STAGES.*.waves;
*   Boot Hill's 'skel@' rise out of the ground, Main Street's skeletons
*   walk in; $FF = the boss)
WaveBH              fdb       0
                    fcb       3,TY.Skel,TY.Dillo,TY.Skel
                    fdb       360
                    fcb       4,TY.Skel,TY.Skel,TY.Dillo,TY.Skel
                    fdb       760
                    fcb       4,TY.Dillo,TY.Skel,TY.Dillo,TY.Skel
                    fdb       1160
                    fcb       4,TY.Skel,TY.Skel,TY.Skel,TY.Skel
                    fdb       1600
                    fcb       $FF,0               Two-Bit
WaveMS              fdb       0
                    fcb       3,TY.Coy,TY.Coy,TY.Dillo
                    fdb       380
                    fcb       4,TY.Coy,TY.SkelW,TY.Coy,TY.Dillo
                    fdb       780
                    fcb       4,TY.SkelW,TY.Coy,TY.SkelW,TY.Dillo
                    fdb       1200
                    fcb       4,TY.Coy,TY.SkelW,TY.Coy,TY.SkelW
                    fdb       1660
                    fcb       6,TY.SkelW,TY.Coy,TY.SkelW,TY.Coy,TY.Coy,TY.SkelW
                    fdb       1700
                    fcb       $FF,1               Big Shell Dillon
WaveGT              fdb       0                   Ghost Town: the street, then the saloon
                    fcb       3,TY.Rat,TY.Coy,TY.SkelW
                    fdb       360
                    fcb       4,TY.Rat,TY.Coy,TY.Rat,TY.SkelW
                    fdb       720
                    fcb       4,TY.SkelW,TY.Rat,TY.Coy,TY.SkelW
                    fdb       1060
                    fcb       4,TY.Coy,TY.Rat,TY.Coy,TY.Rat
                    fdb       1360
                    fcb       6,TY.Rat,TY.SkelW,TY.Coy,TY.Rat,TY.Coy,TY.SkelW
                    fdb       1712
                    fcb       $FF,2               Doc Gila
WaveCD              fdb       1150                the Cattle Drive: on foot at the corral gate
                    fcb       4,TY.Coy,TY.Rat,TY.Coy,TY.SkelW
                    fdb       1712
                    fcb       $FF,3               Jackrabbit Jack

********************************************************************
* StageClear - the stage is won: he taunts
********************************************************************
StageClear          clr       <lock
                    lda       #MU.clear
                    lbsr      Music
                    lda       #PH.Clear
                    lbsr      SetPh
                    ldd       #0
                    std       <hvx
                    std       <hvz
                    std       <hvh
                    std       <hh
                    lda       #ST.Taunt
                    lbra      SetS

* GameOver - the last life is gone
GameOver            lbsr      HiScore
                    lda       #MU.over
                    lbsr      Music
                    lda       #PH.Over
                    lbra      SetPh

********************************************************************
* AddScore - D = points.  A combo multiplies them: the hits landed
*   within 1.4 s of each other, up to eight (brawler.js addScore).
*   Exit: D = the points scored.  X and Y are kept.
********************************************************************
AddScore            pshs      x,y
                    std       <scw
                    lda       <combo
                    tst       <combot
                    bne       as1
                    clra
as1                 cmpa      #8
                    bhs       as2
                    inca
as2                 sta       <combo
                    sta       <scn
                    lda       #ComboLen
                    sta       <combot
                    ldd       #0                  points x the combo
as3                 addd      <scw
                    dec       <scn
                    bne       as3
                    std       <scw
                    bsr       AddBcd
                    ldd       <scw
                    puls      x,y,pc

* AddBcd - scw = points (binary, below 10000) added to the BCD score
AddBcd              ldd       <scw
                    std       <bcd                the remainder as it goes
                    ldx       #1000
                    bsr       Dig
                    lsla
                    lsla
                    lsla
                    lsla
                    sta       <scn
                    ldx       #100
                    bsr       Dig
                    ora       <scn
                    sta       <scn                thousands and hundreds
                    ldx       #10
                    bsr       Dig
                    lsla
                    lsla
                    lsla
                    lsla
                    ora       <bcd+1              tens and ones
                    adda      <score+3            add, low byte first
                    daa
                    sta       <score+3
                    lda       <score+2
                    adca      <scn
                    daa
                    sta       <score+2
                    lda       <score+1
                    adca      #0
                    daa
                    sta       <score+1
                    lda       <score
                    adca      #0
                    daa
                    sta       <score
                    rts

* Dig - X = a power of ten: A = bcd / X, bcd = the remainder
Dig                 pshs      x
                    clr       <scd
                    ldd       <bcd
dg1                 cmpd      ,s
                    blo       dg2
                    subd      ,s
                    inc       <scd
                    bra       dg1
dg2                 std       <bcd
                    lda       <scd
                    puls      x,pc
