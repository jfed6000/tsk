FileGT              fcc       /tiles_gt.bin/
                    fcb       $0D
                    fcc       /maps_gt.bin/
                    fcb       $0D
                    fcc       /spr_gt.bin/
                    fcb       $0D
                    fcc       /frr_gt.bin/
                    fcb       $0D
                    fcc       /pal_gt.bin/
