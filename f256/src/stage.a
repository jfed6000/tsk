********************************************************************
* stage.a - the stage: waves, the screen lock, GO, the phases (play,
*   clear, the end, game over), the score, and starting over.
*   brawler.js loadStage, startWave, updateWaves, stageClear, simulate.
********************************************************************

* phases
PH.Play             equ       0
PH.Clear            equ       1                   the stage is won: a taunt, the title
PH.End              equ       2                   TO BE CONTINUED... (Main Street comes in sprint 4)
PH.Over             equ       3                   game over
PH.Ending           equ       6                   the ending (ending.a): Boot Hill at sundown, the boot shop

TitleLen              equ       192                 the stage title shows 3.2 s
GoLen               equ       180                 "GO >>" blinks 3 s after a wave
ClearT              equ       210                 3.5 s of the clear before the end
WaitT               equ       120                 the end and game over take a jump after 2 s
ComboLen              equ       84                  1.4 s to land the next hit of a combo

********************************************************************
* GameInit - a new game: everything cleared, the hero at the start
********************************************************************
GameInit            ldd       #0
                    std       <attt
                    lbsr      CombatInit          health, lives
                    ldd       <ticks              a different fight each time
                    eora      <rnd
                    eorb      <rnd+1
                    bne       gi2
                    incb
gi2                 std       <rnd
                    lbsr      HudInit
                    clr       <hwep
                    clr       <hammo
                    ldd       #0
                    std       <score
                    std       <score+2
                    ldd       #$0003              a hat at 30,000 points
                    std       nexthat,u
                    clr       <combo
                    clr       <combot
                    lda       stgarg,u            (tsk m: Main Street first)
* StageInit - A = the stage: its art loaded, its street set up, its music.
*   The hero keeps his health, lives, score.
StageInit           bsr       StageSet
                    lbcs      Fail
                    bra       si00

* StageSet - A = the stage: its record, its stops, and its art (unless it's
*   the art already loaded).  The title uses it for Boot Hill's backdrop.
*   Exit: carry = error in B
StageSet            sta       stgn,u
                    ldb       #SR.Size            its record
                    mul
                    leax      StgTab,pcr
                    leax      d,x
                    stx       stgp,u
                    ldd       SR.W,x              its width, and the stops it sets: at most MaxW,
                    cmpd      #MaxW               the most a 12.4 position holds signed (2047 px).
                    bls       ss0x                Main Street is 2400 px wide, but its last wave
                    ldd       #MaxW               is at 1660 and nothing goes past ~2000 in play
ss0x                std       levw,u
                    subd      #320
                    lbsr      To124
                    std       cammax,u
                    ldd       levw,u
                    subd      #10
                    lbsr      To124
                    std       hxmax,u
                    lda       SR.Flags,x
                    sta       sflags,u
                    lda       SR.NWv,x
                    sta       nwaves,u
                    lda       stgn,u              already loaded (the title's Boot Hill)?
                    cmpa      ldstg,u
                    beq       ss9x
                    lbsr      LoadStage           the tiles, maps and its own sprites
                    bcs       ss8x
                    lda       stgn,u
                    sta       ldstg,u
ss9x                andcc     #$FE
ss8x                rts
si00                leax      en,u                every table: enemies, skulls, bullets, popups, particles
                    ldy       #fridx-en
gi1                 clr       ,x+
                    leay      -1,y
                    bne       gi1
                    leax      en,u                each slot's id again (the clear took them: no HUD bars)
                    lda       #1
gi1a                sta       EN.Id,x
                    leax      EN.Size,x
                    inca
                    cmpa      #NEn
                    bls       gi1a
                    lbsr      HeroInit
                    lbsr      CamInit
                    lbsr      PickInit
                    clr       riding,u            not riding (the core tests these; ride.a sets them)
                    clr       hmount,u
                    clr       hremount,u
                    clr       rtread,u
                    clr       lon,u
                    ldx       #80*16              the walking band: 80 deep (a gang spawns 8..71),
                    lda       #64                 the train's roof 48 (8..39)
                    ldb       sflags,u
                    bitb      #SG.Train
                    beq       si0a
                    ldx       #48*16
                    lda       #32
si0a                stx       zmax16,u
                    sta       zspan,u
                    lbsr      SignInit            (Ghost Town's signs: tskgt)
                    lbsr      RideInit            (the Cattle Drive's ride: tskcd)
                    lbsr      TrainInit           (the Train Heist's train: tskth)
                    lbsr      DoorInit            (the Mission's doors: tskmi)
                    ldd       #0
                    std       <phaset
                    std       <titlet
                    clr       <phase
                    clr       <wavei
                    clr       <got
                    clr       <lock
                    clr       <hitstop
                    clr       <bslot
                    clr       <bslot+1
                    clr       <shake
                    clr       twst,u
                    clr       gdown,u
                    clr       dstep,u
                    ldd       #240                the first tumbleweed after 4 s
                    std       twt,u
                    ldd       #420                the first bolt after 7 s
                    std       <nbolt
                    ldx       stgp,u              its music (after the clear above: the MIDI buffer's in it)
                    lda       SR.Mus,x
                    lbsr      Music
                    lda       sflags,u            the ending: a scene, no waves (ending.a)
                    bita      #SG.Ending
                    lbne      EndingInit
                    tst       <skipb              (tsk k: straight to the stage's boss)
                    bne       gi4
                    lda       sflags,u
                    bita      #SG.Intro
                    beq       gi3
                    lbra      IntroInit           Boot Hill begins in the grave
gi4                 clr       riding,u            (and no ride: on foot at the corral)
                    clr       hmount,u
                    clr       rtread,u
                    lda       nwaves,u            the last wave: the boss's
                    deca
                    sta       <wavei
                    lda       #1
                    sta       <hatop
                    lbsr      WaveRec
                    ldd       ,x                  its spot
                    std       <cam
                    pshs      d
                    lbsr      To124
                    std       <camf
                    puls      d
                    addd      #80
                    lbsr      To124
                    std       <hx
                    ldd       #40*16
                    std       <hz
gi3                 rts

* LoadStage - stage's art, with nothing on the screen while it loads:
*   the maps and sprites off, the tiles, maps, sprite overlay, frame
*   records and sprite CLUT read in, its stage module linked,
*   the tile sets and maps set up again.  Exit: carry = error in B
LoadStage           lbsr      MapsOff
                    lbsr      ClearRecs
                    lbsr      PushRecs
                    ldx       stgp,u
                    ldd       SR.Files,x          its file names: tiles, maps, sprites, frame records, palette, tile
*                                                 palette, shades (or none), module
                    leay      StgTab,pcr
                    leax      d,y
                    pshs      x
                    lda       <tilblk             tiles_<s>.bin
                    ldb       #NTilBlk
                    ldy       #0
                    lbsr      LoadFile
                    puls      x
                    lbcs      ls9
                    lbsr      NextName
                    pshs      x
                    lda       <mapblk             maps_<s>.bin
                    ldb       #NMapBlk
                    ldy       #0
                    lbsr      LoadFile
                    puls      x
                    lbcs      ls9
                    lbsr      NextName
                    pshs      x
                    lda       <sprblk             spr_<s>.bin, at the overlay's cells
                    adda      #SPR.Base/8
                    ldb       #NOvlBlk
                    ldy       #0
                    lbsr      LoadFile
                    puls      x
                    bcs       ls9
                    bsr       NextName
                    pshs      x
                    lda       frblk,u             frr_<s>.bin: its frames' records, after the shared ones
                    ldb       #1
                    ldy       #FRR.Sh
                    lbsr      LoadFile
                    puls      x
                    bcs       ls9
                    bsr       NextName            pal_<s>.bin: its sprite CLUT (the shared colours and its own)
                    pshs      x
                    lda       clublk,u            (clublk's first K: CLUT 0's)
                    ldb       #1
                    ldy       #0
                    lbsr      LoadFile
                    bcs       ls8
                    clrb
                    ldy       #CLUT.Spr*256
                    lbsr      ClutK
ls8                 puls      x
                    bcs       ls9
                    bsr       NextName            tpal_<s>.bin: its tile CLUT (StageGfx writes it)
                    pshs      x
                    lda       clublk,u            (clublk's second K: CLUT 3's)
                    ldb       #1
                    ldy       #1024
                    lbsr      LoadFile
                    puls      x
                    bcs       ls9
                    bsr       NextName            shade_<s>.bin: its 61 shades (Main Street's dusk,
                    lda       ,x                  the train's tunnels), if it has them
                    cmpa      #$0D
                    beq       ls7
                    pshs      x
                    lda       duskblk,u
                    ldb       #NDuskBlk
                    ldy       #0
                    lbsr      LoadFile
                    puls      x
                    bcs       ls9
ls7                 bsr       NextName            its code: the stage module (stgmod.a)
                    lbsr      StgLoad
                    bcs       ls9
                    lbra      StageGfx
ls9                 rts

* NextName - X = a $0D-terminated name: X = the one after it
NextName            lda       ,x+
                    cmpa      #$0D
                    bne       NextName
                    rts

********************************************************************
* The stages (brawler.js STAGES).  A record: width (px), the three maps'
*   widths and offsets, tile sets, flags, song, waves (count, table),
*   barrels (count, table), title frames (name, under it, the clear),
*   file names - the tables as offsets from StgTab.
********************************************************************
SR.W                equ       0
SR.Map              equ       2                   three of width, offset
SR.Sets             equ       14
SR.Flags            equ       15
SR.Mus              equ       16
SR.NWv              equ       17
SR.Waves            equ       18
SR.NBar             equ       20
SR.Bars             equ       21
SR.Name             equ       23
SR.Sub              equ       25
SR.Clr              equ       27
SR.Files            equ       29
SR.Size             equ       31
SG.Intro            equ       1                   the opening, the big title
SG.Light            equ       2                   lightning
SG.Dusk             equ       4                   night falls, wave by wave
SG.Ride             equ       8                   the ride: in the saddle, the trail scrolling (ride.a)
SG.Train            equ       16                  the train: its roof narrower, the scenery going by, gaps, tunnels (train.a)
SG.Siege            equ       32                  the Mission: the church doors, the siege (mission.a)
SG.Noon             equ       64                  High Noon: the clock tower, the duel (diamond.a)
SG.Ending           equ       128                 the ending: no waves, a scene (ending.a)
NOvlBlk             equ       (SPR.Ovl+7)/8
MaxW                equ       2032                (x 16 = 32512: under 32767, so signed compares work)

StgTab              fdb       BH.W                Boot Hill at midnight
                    fdb       BH.MAP0.W,BH.MAP0.Of,BH.MAP1.W,BH.MAP1.Of,BH.MAP2.W,BH.MAP2.Of
                    fcb       BH.TIL.Sets,SG.Intro+SG.Light,MU.boothill,5
                    fdb       WaveBH-StgTab
                    fcb       6
                    fdb       BarBH-StgTab
                    fdb       TX.boothill,TX.midnight,TX.clear
                    fdb       FileBH-StgTab
                    fdb       MS.W                Main Street at dusk
                    fdb       MS.MAP0.W,MS.MAP0.Of,MS.MAP1.W,MS.MAP1.Of,MS.MAP2.W,MS.MAP2.Of
                    fcb       MS.TIL.Sets,SG.Dusk,MU.boogie,6
                    fdb       WaveMS-StgTab
                    fcb       8
                    fdb       BarMS-StgTab
                    fdb       TX.mainst,TX.dusk,TX.msclear
                    fdb       FileMS-StgTab
                    fdb       GT.W                Ghost Town at moonrise: Doc Gila's
                    fdb       GT.MAP0.W,GT.MAP0.Of,GT.MAP1.W,GT.MAP1.Of,GT.MAP2.W,GT.MAP2.Of
                    fcb       GT.TIL.Sets,0,MU.deadman,6
                    fdb       WaveGT-StgTab
                    fcb       11
                    fdb       BarGT-StgTab
                    fdb       TX.ghostt,TX.moonrise,TX.gtclear
                    fdb       FileGT-StgTab
                    fdb       CD.W                the Cattle Drive at sunup: the ride, then Jack's corral
                    fdb       CD.MAP0.W,CD.MAP0.Of,CD.MAP1.W,CD.MAP1.Of,CD.MAP2.W,CD.MAP2.Of
                    fcb       CD.TIL.Sets,SG.Ride,MU.stampede,2
                    fdb       WaveCD-StgTab
                    fcb       5
                    fdb       BarCD-StgTab
                    fdb       TX.cattle,TX.sunup,TX.cdclear
                    fdb       FileCD-StgTab
                    fdb       TH.W                the Train Heist at midday: along the roofs, Sting on the tender
                    fdb       TH.MAP0.W,TH.MAP0.Of,TH.MAP1.W,TH.MAP1.Of,TH.MAP2.W,TH.MAP2.Of
                    fcb       TH.TIL.Sets,SG.Train,MU.heist,6
                    fdb       WaveTH-StgTab
                    fcb       7
                    fdb       BarTH-StgTab
                    fdb       TX.trainh,TX.midday,TX.thclear
                    fdb       FileTH-StgTab
                    fdb       MI.W                the Mission at sundown: the siege of the church doors, Bullrush
                    fdb       MI.MAP0.W,MI.MAP0.Of,MI.MAP1.W,MI.MAP1.Of,MI.MAP2.W,MI.MAP2.Of
                    fcb       MI.TIL.Sets,SG.Dusk+SG.Siege,MU.laststand,7
                    fdb       WaveMI-StgTab
                    fcb       6
                    fdb       BarMI-StgTab
                    fdb       TX.mission,TX.sundown,TX.miclear
                    fdb       FileMI-StgTab
                    fdb       HN.W                High Noon on Main Street: the last of the gang, the duel, Diamondback
                    fdb       HN.MAP0.W,HN.MAP0.Of,HN.MAP1.W,HN.MAP1.Of,HN.MAP2.W,HN.MAP2.Of
                    fcb       HN.TIL.Sets,SG.Noon,MU.boogie,4
                    fdb       WaveHN-StgTab
                    fcb       5
                    fdb       BarHN-StgTab
                    fdb       TX.hnoon,TX.mainsub,0          (no clear: the ending)
                    fdb       FileHN-StgTab
                    fdb       EN.W                the ending: Boot Hill at sundown, then the boot shop (a bitmap)
                    fdb       EN.MAP0.W,EN.MAP0.Of,EN.MAP1.W,EN.MAP1.Of,EN.MAP2.W,EN.MAP2.Of
                    fcb       EN.TIL.Sets,SG.Ending,MU.boothill,0
                    fdb       WaveHN-StgTab
                    fcb       0
                    fdb       BarEN-StgTab
                    fdb       0,0,0
                    fdb       FileEN-StgTab

FileBH              fcc       /tiles_bh.bin/
                    fcb       $0D
                    fcc       /maps_bh.bin/
                    fcb       $0D
                    fcc       /spr_bh.bin/
                    fcb       $0D
                    fcc       /frr_bh.bin/
                    fcb       $0D
                    fcc       /pal_bh.bin/
                    fcb       $0D
                    fcc       /tpal_bh.bin/
                    fcb       $0D
                    fcb       $0D
                    fcb       $0D
FileCD              fcc       /tiles_cd.bin/
                    fcb       $0D
                    fcc       /maps_cd.bin/
                    fcb       $0D
                    fcc       /spr_cd.bin/
                    fcb       $0D
                    fcc       /frr_cd.bin/
                    fcb       $0D
                    fcc       /pal_cd.bin/
                    fcb       $0D
                    fcc       /tpal_cd.bin/
                    fcb       $0D
                    fcb       $0D
                    fcc       /tskcd/
                    fcb       $0D
FileTH              fcc       /tiles_th.bin/
                    fcb       $0D
                    fcc       /maps_th.bin/
                    fcb       $0D
                    fcc       /spr_th.bin/
                    fcb       $0D
                    fcc       /frr_th.bin/
                    fcb       $0D
                    fcc       /pal_th.bin/
                    fcb       $0D
                    fcc       /tpal_th.bin/
                    fcb       $0D
                    fcc       /shade_th.bin/
                    fcb       $0D
                    fcc       /tskth/
                    fcb       $0D
FileHN              fcc       /tiles_hn.bin/
                    fcb       $0D
                    fcc       /maps_hn.bin/
                    fcb       $0D
                    fcc       /spr_hn.bin/
                    fcb       $0D
                    fcc       /frr_hn.bin/
                    fcb       $0D
                    fcc       /pal_hn.bin/
                    fcb       $0D
                    fcc       /tpal_hn.bin/
                    fcb       $0D
                    fcb       $0D
                    fcc       /tskhn/
                    fcb       $0D
FileEN              fcc       /tiles_en.bin/
                    fcb       $0D
                    fcc       /maps_en.bin/
                    fcb       $0D
                    fcc       /spr_en.bin/
                    fcb       $0D
                    fcc       /frr_en.bin/
                    fcb       $0D
                    fcc       /pal_en.bin/
                    fcb       $0D
                    fcc       /tpal_en.bin/
                    fcb       $0D
                    fcb       $0D
                    fcc       /tsken/
                    fcb       $0D
FileMI              fcc       /tiles_mi.bin/
                    fcb       $0D
                    fcc       /maps_mi.bin/
                    fcb       $0D
                    fcc       /spr_mi.bin/
                    fcb       $0D
                    fcc       /frr_mi.bin/
                    fcb       $0D
                    fcc       /pal_mi.bin/
                    fcb       $0D
                    fcc       /tpal_mi.bin/
                    fcb       $0D
                    fcc       /shade_mi.bin/
                    fcb       $0D
                    fcc       /tskmi/
