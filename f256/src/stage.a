FileMS              fcc       /tiles_ms.bin/
                    fcb       $0D
                    fcc       /maps_ms.bin/
                    fcb       $0D
                    fcc       /spr_ms.bin/
                    fcb       $0D
                    fcc       /frr_ms.bin/
                    fcb       $0D
                    fcc       /pal_ms.bin/
