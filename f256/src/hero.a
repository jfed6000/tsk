********************************************************************
* hero.a - the Shitkickers: input -> state -> physics -> animation.
*   A translation of brawler.js updatePlayer and pickAnim (the parts
*   with no enemies yet).  Positions and velocities are 12.4 fixed
*   point; the browser's per-second numbers become per-pass ones
*   (60 passes a second, docs/port-plan.md).
********************************************************************

* states (the order matters: Jump, JKick and Stomp are the air states)
ST.Idle             equ       0
ST.Walk             equ       1
ST.Jump             equ       2
ST.JKick            equ       3                   the flying side kick
ST.Stomp            equ       4
ST.Land             equ       5
ST.Snap             equ       6                   X: the snap kick, three to a combo
ST.Side             equ       7                   C or back + X: the side kick
ST.Taunt            equ       8
ST.Hurt             equ       9                   hit: knocked back, then free again
ST.Whip             equ       10                  X with the whip
ST.Shoot            equ       11                  X with the six-shooter
ST.Die              equ       12                  the death scene (death.a): toppling over
ST.Dead             equ       13                  flat out
ST.Reach            equ       14                  reaching up for the hat
ST.GetUp            equ       15                  up again, the hat held high
ST.Grab             equ       16                  holding an outlaw by the collar (grab.a)
ST.Knee             equ       17                  X while holding: the knee
ST.Throw            equ       18                  C or jump while holding: the throw
ST.Roped            equ       19                  on the end of Jack's lasso: yanked to him (jack.a)
ST.Duck             equ       20                  flat on the train's roof for a tunnel (down, when train.a DuckNow says)
ST.Fall             equ       21                  down a gap between the cars (train.a FallStep)

* speeds, 12.4 per pass (browser: px/s at 60 passes)
WalkX               equ       28                  105 px/s
WalkZ               equ       17                  62 px/s
JumpV               equ       96                  360 px/s
Grav                equ       5                   1150 px/s/s
FlyV                equ       45                  the flying kick, 170 px/s
StompV              equ       -149                the stomp's drop, 560 px/s
SideV               equ       24                  the side kick's lunge, 90 px/s

* timings, passes (the browser's durations; the frame timing comes from tskassets.d)
TurnLen             equ       6                   the 3/4 turn frame on stopping (0.1 s)
LandFree            equ       5                   landing: free to move after (0.08 s)
SnapDur             equ       HR.snap.N*HR.snap.T
SnapChain           equ       SnapDur*4/5         a queued kick chains from here
ChainT              equ       27                  after a snap kick: the next one chains (0.45 s)
SideDur             equ       HR.side.N*HR.side.T
SideHit             equ       3                   the side kick's first hit frame: it lunges
TauntDur            equ       HR.taunt.N*HR.taunt.T
JumpUp              equ       32                  jump frames: rising above 2 px/pass,
JumpDn              equ       -32                 falling below -2

HeroInit            ldd       #70*16
                    std       <hx
                    ldd       #40*16
                    std       <hz
                    lda       #ST.Idle
                    lbsr      SetS
                    lda       #TurnLen            straight to the idle, no turn
                    sta       <ht
                    clr       dying,u
                    clr       dhat,u
                    clr       hheld,u
                    clr       hheld+1,u
                    rts

* SetS - A = the new state.  Its time starts at 0, its animation from frame 0,
*   and it's a new attack (hatk: each attack hits each thing once; never 0)
SetS                sta       <hst
                    pshs      a,y                 its sound (brawler.js: jump, whoosh, land, tip)
                    leay      SetSfx,pcr
                    lda       a,y
                    bmi       ss00
                    lbsr      Sfx
ss00                puls      a,y
                    clr       <ht
                    clr       <hdesc
                    clr       <hdesc+1
                    inc       <hatk
                    bne       ss0
                    inc       <hatk
ss0                 rts

********************************************************************
* Hero - one pass
********************************************************************
Hero                lda       <ht                 the state's time, held at 255
                    inca
                    beq       h0
                    sta       <ht
h0                  lda       <hinv
                    beq       h0a
                    dec       <hinv
h0a                 lda       <hchain
                    beq       h1
                    dec       <hchain
* dx, dz: -1, 0 or 1 from what is held
h1                  tst       dying,u             the death scene: no input
                    lbne      HeroDeath
                    lbsr      DuelInput           (High Noon's standoff: his input is the duel's - diamond.a)
                    clr       <hdx
                    clr       <hdz
                    lda       <inp
                    bita      #IN.Right
                    beq       h2
                    inc       <hdx
h2                  bita      #IN.Left
                    beq       h3
                    dec       <hdx
h3                  bita      #IN.Down
                    beq       h4
                    inc       <hdz
h4                  bita      #IN.Up
                    beq       h5
                    dec       <hdz
* free to act: standing, walking, or a moment after landing
h5                  lda       <hst
                    cmpa      #ST.Idle
                    beq       hfree
                    cmpa      #ST.Walk
                    beq       hfree
                    cmpa      #ST.Land
                    lbne      hsw
                    lda       <ht
                    cmpa      #LandFree
                    lbls      hsw
* back = pressing away from his facing; then he faces where he's pressed
hfree               clr       <hback
                    lda       <hdx
                    beq       hf1
                    bmi       hf0
                    lda       <hface              pressing right: back if he faced left
                    sta       <hback
                    clr       <hface
                    bra       hf1
hf0                 lda       <hface              pressing left: back if he faced right
                    eora      #1
                    sta       <hback
                    lda       #1
                    sta       <hface
hf1                 ldx       #0                  walking
                    lda       <hdx
                    beq       hf3
                    ldx       #WalkX
                    tsta
                    bpl       hf3
                    ldx       #-WalkX
hf3                 stx       <hvx
                    ldx       #0
                    lda       <hdz
                    beq       hf5
                    ldx       #WalkZ
                    tsta
                    bpl       hf5
                    ldx       #-WalkZ
hf5                 stx       <hvz
* TUNNEL!: holding down is duck (train.a DuckNow: the warning's up, or the mouth or a pit-prop is coming)
                    lda       <inp
                    bita      #IN.Down
                    beq       hp0
                    lbsr      DuckNow
                    bcc       hp0
                    lda       #ST.Duck
                    lbsr      SetS
                    lbra      hsw
* the presses, in the browser's order
hp0                 lda       <ipress
                    bita      #IN.Jump
                    beq       hp1
                    lda       #ST.Jump
                    lbsr      SetS
                    ldd       #JumpV
                    std       <hvh
                    ldd       <hvz                half the depth speed in the air
                    asra
                    rorb
                    std       <hvz
                    lbra      hsw
hp1                 bita      #IN.Kick            X over a weapon picks it up
                    beq       hp1a
                    lbsr      Underfoot
                    bcs       hp1a
                    lbsr      PickUp
                    lbra      hsw
hp1a                lda       <ipress
                    bita      #IN.Side            C: the side kick
                    bne       hpside
                    bita      #IN.Kick
                    beq       hp3
                    tst       <hback              back + X: the side kick
                    bne       hpside
                    lda       <hwep               X with a weapon: use it
                    cmpa      #WP.Whip
                    bne       hp1b
                    lda       #ST.Whip
                    lbsr      SetS
                    lbra      hsw
hp1b                cmpa      #WP.Gun
                    bne       hp1c
                    lda       #ST.Shoot
                    lbsr      SetS
                    lbsr      HeroFire
                    lbra      hsw
hp1c
                    lda       <hchain             X: the next snap kick of the combo
                    beq       hp2a
                    lda       <hstep
                    cmpa      #3
                    bhs       hp2a
                    inca
                    bra       hp2b
hp2a                lda       #1
hp2b                sta       <hstep
                    lda       #ST.Snap
                    lbsr      SetS
                    bra       hsw
hpside              lda       #ST.Side
                    lbsr      SetS
                    bra       hsw
hp3                 bita      #IN.Taunt
                    beq       hp4
                    lda       #ST.Taunt
                    lbsr      SetS
                    bra       hsw
hp4                 lda       <hdx                walking into an outlaw that's open: the grab
                    beq       hp4a
                    lbsr      GrabTarget
                    bcs       hp4a
                    lbsr      Grab
                    bra       hsw
hp4a                lda       <hdx                nothing pressed: walk or stand
                    ora       <hdz
                    beq       hp5
                    lda       #ST.Walk
                    bra       hp6
hp5                 lda       #ST.Idle
hp6                 cmpa      <hst
                    beq       hsw
                    lbsr      SetS

* what each state does this pass
hsw                 lda       <hst
                    cmpa      #ST.Duck
                    beq       sDuck
                    cmpa      #ST.Fall
                    beq       sFall
                    cmpa      #ST.Roped
                    lbeq      sRoped
                    cmpa      #ST.Grab
                    lbeq      sGrab
                    cmpa      #ST.Knee
                    lbeq      sKnee
                    cmpa      #ST.Throw
                    lbeq      sThrow
                    cmpa      #ST.Snap
                    beq       sSnap
                    cmpa      #ST.Side
                    lbeq      sSide
                    cmpa      #ST.Taunt
                    lbeq      sTaunt
                    cmpa      #ST.Land
                    lbeq      sLand
                    cmpa      #ST.Whip
                    lbeq      sLash
                    cmpa      #ST.Shoot
                    lbeq      sFire
                    cmpa      #ST.Hurt
                    lbeq      sHurt
                    cmpa      #ST.Jump
                    lblo      hmove
                    cmpa      #ST.Stomp
                    lbls      sAir
                    lbra      hmove

* duck: flat on the roof until down's let go or the danger's past
sDuck               ldd       #0
                    std       <hvx
                    std       <hvz
                    lda       <inp
                    bita      #IN.Down
                    beq       sdk1
                    lbsr      DuckNow
                    lbcs      hmove
sdk1                lda       #ST.Idle
                    lbsr      SetS
                    lbra      hmove
* down a gap: train.a's (he drops, and comes back up on a car)
sFall               lbsr      FallStep
                    lbra      hv2

* the snap kick: a later press during it queues the next (not the press
*   that started it); the combo is three
sSnap               ldd       #0
                    std       <hvx
                    std       <hvz
                    tst       <ht
                    beq       ss1
                    lda       <ipress
                    bita      #IN.Kick
                    beq       ss1
                    lda       #1
                    sta       <hqd
ss1                 lda       <ht
                    cmpa      #SnapChain
                    lblo      hmove
                    tst       <hqd
                    beq       ss2
                    lda       <hstep
                    cmpa      #3
                    bhs       ss2
                    clr       <hqd
                    inc       <hstep
                    lda       #ST.Snap
                    lbsr      SetS
                    lbra      hmove
ss2                 lda       <ht
                    cmpa      #SnapDur
                    lblo      hmove
                    clr       <hqd
                    lda       #ST.Idle
                    lbsr      SetS
                    lda       #ChainT
                    sta       <hchain
                    lbra      hmove

* the side kick: he lunges on the first hit frame
sSide               ldd       #0
                    std       <hvz
                    std       <hvx
                    lda       <hfr
                    cmpa      #SideHit
                    bne       sd1
                    ldd       #SideV
                    tst       <hface
                    beq       sd0
                    ldd       #-SideV
sd0                 std       <hvx
sd1                 lda       <ht
                    cmpa      #SideDur
                    lblo      hmove
                    lda       #ST.Idle
                    lbsr      SetS
                    lbra      hmove

sTaunt              ldd       #0
                    std       <hvx
                    std       <hvz
                    lda       <ht
                    cmpa      #TauntDur
                    lblo      hmove
                    lda       #ST.Idle
                    lbsr      SetS
                    lbra      hmove

* the whip: it cracks on its second frame
sLash               ldd       #0
                    std       <hvx
                    std       <hvz
                    lda       <hfr
                    cmpa      #1
                    bne       sl1
                    tst       <hft
                    bne       sl1
                    lbsr      WhipHit
sl1                 lda       <ht
                    cmpa      #WhipDur
                    lblo      hmove
                    lda       #ST.Idle
                    lbsr      SetS
                    lbra      hmove

* the six-shooter: out of rounds, he tosses it
sFire              ldd       #0
                    std       <hvx
                    std       <hvz
                    lda       <ht
                    cmpa      #ShootDur
                    lblo      hmove
                    tst       <hammo
                    bne       sf9
                    lbsr      EmptyGun
sf9                 lda       #ST.Idle
                    lbsr      SetS
                    lbra      hmove

sLand               ldd       <hvx                he skids to a stop
                    asra
                    rorb
                    std       <hvx
                    lbra      hmove

* roped: on the end of Jack's lasso, yanked to him (220 px/s), no say in it
sRoped              ldx       <bslot
                    beq       sro9
                    lda       <bst
                    cmpa      #JS.Reel
                    bne       sro9
                    ldd       #59
                    pshs      d
                    ldd       EN.X,x
                    cmpd      <hx
                    bge       sro1
                    ldd       #-59
                    std       ,s
sro1                puls      d
                    std       <hvx
                    clr       <hface
                    tsta
                    bpl       sro2
                    inc       <hface
sro2                ldd       EN.Z,x
                    subd      <hz
                    std       <tdz
                    lbsr      AbsD
                    ldx       #0
                    cmpd      #2*16
                    bls       sro3
                    ldx       #21
                    tst       <tdz
                    bpl       sro3
                    ldx       #-21
sro3                stx       <hvz
                    lbra      hmove
sro9                lda       #ST.Idle
                    lbsr      SetS
                    lbra      hmove

* hurt: knocked back, sliding to a stop; if he was in the air he falls
sHurt               ldd       <hvx
                    lbsr      Decay
                    std       <hvx
                    ldd       <hh
                    bne       shu1
                    ldd       <hvh
                    beq       shu2
shu1                ldd       <hvh
                    subd      #Grav
                    std       <hvh
                    addd      <hh
                    std       <hh
                    bgt       shu2
                    ldd       #0
                    std       <hh
                    std       <hvh
shu2                lda       <ht
                    cmpa      #HurtT
                    lblo      hmove
                    ldd       <hh                 (tossed - El Toro's hook: not till he's down again)
                    lbne      hmove
                    lda       #ST.Idle
                    lbsr      SetS
                    lbra      hmove

* the air: X turns a jump into the flying kick, Z into the stomp - but not
*   on the pass the jump began, or its own press would stomp at once
sAir                tst       <ht
                    beq       sa2
                    cmpa      #ST.Jump
                    bne       sa1
                    lda       <ipress
                    bita      #IN.Kick
                    beq       sa1
                    lda       #ST.JKick
                    lbsr      SetS
                    bra       sa2
sa1                 lda       <hst
                    cmpa      #ST.Stomp
                    beq       sa2
                    lda       <ipress
                    bita      #IN.Jump
                    beq       sa2
                    lda       #ST.Stomp
                    lbsr      SetS
                    ldd       #StompV
                    std       <hvh
                    ldd       #0
                    std       <hvx
sa2                 lda       <hst
                    cmpa      #ST.JKick
                    bne       sa3
                    ldd       #FlyV
                    tst       <hface
                    beq       sa25
                    ldd       #-FlyV
sa25                std       <hvx
sa3                 ldd       <hvh                gravity
                    subd      #Grav
                    std       <hvh
                    addd      <hh
                    std       <hh
                    bgt       hmove
                    ldd       #0                  down: land
                    std       <hh
                    std       <hvh
                    std       <hvx
                    std       <hvz
                    lda       <hst
                    cmpa      #ST.Stomp
                    bne       sa4
                    lbsr      StompShock
sa4                 ldd       <hx                 a puff of dust
                    std       <sx
                    ldd       <hz
                    std       <sz
                    lda       #3
                    lbsr      Puff
                    lda       #ST.Land
                    lbsr      SetS

* move, and keep him in the street: z 0..ZMax, x from the camera's left
*   edge + 10 to the level's end - 10 (the screen's right edge - 10 while
*   the screen is locked)
hmove               ldd       <hx
                    addd      <hvx
                    std       <hx
                    ldd       <hz
                    addd      <hvz
                    bpl       hm1
                    ldd       #0
hm1                 cmpd      zmax16,u
                    ble       hm2
                    ldd       zmax16,u
hm2                 std       <hz
                    tst       hmount,u            in the saddle, the camera moving: carried along
                    beq       hm2a
                    tst       rtread,u
                    bne       hm2a
                    ldd       <hx
                    addd      #RideV
                    std       <hx
hm2a                ldd       <cam
                    addd      #10
                    tst       hmount,u            (the saddle: 24 px in from the edges)
                    beq       hm2b
                    addd      #14
hm2b
                    lslb
                    rola
                    lslb
                    rola
                    lslb
                    rola
                    lslb
                    rola
                    std       <tmp
                    ldd       <hx
                    cmpd      <tmp
                    bge       hm3
                    ldd       <tmp
hm3                 std       <hx                 and to the level's end, or the screen's
                    ldd       hxmax,u             (the stage's end) while it's locked
                    tst       hmount,u
                    beq       hm3b
                    ldd       <tmp
                    addd      #(290-24)*16
                    bra       hm3a
hm3b                tst       <lock
                    beq       hm3a
                    ldd       <tmp
                    addd      #(320-20)*16
hm3a                cmpd      <hx
                    bge       hm4
                    std       <hx
hm4                 lbsr      HeroGap             (the train: over a gap, feet down - he drops)
                    lbsr      HeroAtk             his kicks against everything in his lane

* HeroPassive - out of play (the stage won): his state's clock, the
*   taunt ending, the animation; no input, no moving
HeroPassive         lda       <ht
                    inca
                    beq       hv1
                    sta       <ht
hv1                 lda       <hst
                    cmpa      #ST.Die             (the game's over: he topples and lies there)
                    blo       hv1a
                    cmpa      #ST.GetUp
                    bhi       hv1a
                    lbsr      DeathFall
                    lbra      PickAnim
hv1a                cmpa      #ST.Taunt
                    bne       hv2
                    lda       <ht
                    cmpa      #TauntDur
                    blo       hv2
                    lda       #ST.Idle
                    lbsr      SetS
hv2                 lbra      PickAnim

********************************************************************
* PickAnim - the animation for the state, and its frame.  Descriptors:
*   first frame (2), count, passes a frame, 1 = loops.  A new descriptor
*   starts at frame 0; the same one plays on.
********************************************************************
PickAnim            tst       hmount,u            in the saddle, standing or walking: the seat
                    beq       pa00
                    lda       <hst
                    cmpa      #ST.Walk
                    bhi       pa00
                    leax      AnRide,pcr
                    lbra      paset
pa00                lda       <hst
                    cmpa      #ST.Idle
                    bne       pa1
                    leax      AnTurn,pcr          stopping: the 3/4 turn, then idle
                    ldb       <ht
                    cmpb      #TurnLen
                    blo       paset
                    leax      AnIdle,pcr
                    bra       paset
pa1                 cmpa      #ST.Jump
                    bne       pa2
                    leax      AnJump0,pcr         the jump frame follows the speed
                    ldd       <hvh
                    cmpd      #JumpUp
                    bgt       paset
                    leax      AnJump1,pcr
                    cmpd      #JumpDn
                    bgt       paset
                    leax      AnJump2,pcr
                    bra       paset
pa2                 leay      AnTab,pcr
                    lsla
                    ldd       a,y
                    leax      d,y
paset               cmpx      <hdesc
                    beq       paadv
                    stx       <hdesc
                    clr       <hfr
                    clr       <hft
                    rts
paadv               inc       <hft
                    lda       <hft
                    cmpa      3,x
                    blo       pax
                    clr       <hft
                    inc       <hfr
                    lda       <hfr
                    cmpa      2,x
                    blo       pax
                    tst       4,x
                    beq       panl
                    clr       <hfr
                    rts
panl                deca
                    sta       <hfr
pax                 rts

* HeroFrame - Exit: D = the frame to draw (mirrored when he faces left)
HeroFrame           ldx       <hdesc
                    ldd       ,x
                    addb      <hfr
                    adca      #0
                    tst       <hface
                    beq       hfr1
                    addd      #HR.Mir
hfr1                rts

* the descriptor for each state (Idle and Jump are picked above)
* a state's sound as it starts ($FF = none): idle, walk, jump, flying
*   kick, stomp, land, snap, side, taunt, hurt, whip, shoot
SetSfx              fcb       $FF,$FF,SF.Jump,SF.Whoosh,SF.Whoosh,SF.Land,SF.Whoosh,SF.Whoosh,SF.Tip,$FF
                    fcb       SF.Whoosh,$FF,$FF,$FF,$FF,$FF,$FF,SF.Whoosh,$FF,$FF
                    fcb       SF.Land,$FF         duck (flat on the roof), fall (train.a plays its own)

AnTab               fdb       AnIdle-AnTab
                    fdb       AnRun-AnTab
                    fdb       AnJump0-AnTab
                    fdb       AnAir-AnTab
                    fdb       AnStomp-AnTab
                    fdb       AnLand-AnTab
                    fdb       AnSnap-AnTab
                    fdb       AnSide-AnTab
                    fdb       AnTaunt-AnTab
                    fdb       AnHurt-AnTab
                    fdb       AnWhip-AnTab
                    fdb       AnShoot-AnTab
                    fdb       AnDie-AnTab
                    fdb       AnDead-AnTab
                    fdb       AnReach-AnTab
                    fdb       AnGetUp-AnTab
                    fdb       AnGrab-AnTab
                    fdb       AnSnap-AnTab        (the knee is the snap kick)
                    fdb       AnThrow-AnTab
                    fdb       AnHurt-AnTab        roped
                    fdb       AnDuck-AnTab
                    fdb       AnFall-AnTab

AnDuck              fdb       HR.duck
                    fcb       HR.duck.N,HR.duck.T,0
AnFall              fdb       HR.hurt+1
                    fcb       1,255,0

AnRide              fdb       HR.jump+1           (the jump's tuck: sitting the steer)
                    fcb       1,255,0
AnGrab              fdb       HR.grab
                    fcb       1,255,0
AnThrow             fdb       HR.throw
                    fcb       HR.throw.N,HR.throw.T,0

AnDie               fdb       HR.die
                    fcb       HR.die.N,HR.die.T,0
AnDead              fdb       HR.dead
                    fcb       1,255,0
AnReach             fdb       HR.reach
                    fcb       HR.reach.N,HR.reach.T,1
AnGetUp             fdb       HR.getup
                    fcb       HR.getup.N,HR.getup.T,0

AnWhip              fdb       HR.whip
                    fcb       HR.whip.N,HR.whip.T,0
AnShoot             fdb       HR.shoot
                    fcb       HR.shoot.N,HR.shoot.T,0
AnIdle              fdb       HR.idle
                    fcb       HR.idle.N,HR.idle.T,1
AnTurn              fdb       HR.turn
                    fcb       1,255,0
AnRun               fdb       HR.run
                    fcb       HR.run.N,HR.run.T,1
AnJump0             fdb       HR.jump
                    fcb       1,255,0
AnJump1             fdb       HR.jump+1
                    fcb       1,255,0
AnJump2             fdb       HR.jump+2
                    fcb       1,255,0
AnAir               fdb       HR.airside
                    fcb       1,255,0
AnStomp             fdb       HR.stomp+1
                    fcb       1,255,0
AnLand              fdb       HR.land
                    fcb       1,255,0
AnSnap              fdb       HR.snap
                    fcb       HR.snap.N,HR.snap.T,0
AnSide              fdb       HR.side
                    fcb       HR.side.N,HR.side.T,0
AnTaunt             fdb       HR.taunt
                    fcb       HR.taunt.N,HR.taunt.T,0
AnHurt              fdb       HR.hurt
                    fcb       2,12,0
