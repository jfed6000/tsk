********************************************************************
* Stage - one pass of the stage's clocks and phases (not while a hit
*   holds the action still).  The hero runs only in play.
********************************************************************
Stage               ldd       <phaset
                    addd      #1
                    std       <phaset
                    ldd       <titlet
                    cmpd      #$FFFF
                    beq       sg0
                    addd      #1
                    std       <titlet
sg0                 tst       <combot
                    beq       sg1
                    dec       <combot
sg1                 lda       <phase
                    cmpa      #PH.Title
                    lbeq      TitleStep
                    cmpa      #PH.Intro
                    lbeq      IntroStep
                    cmpa      #PH.Play
                    bne       sg2
                    lbsr      SayStep             a boss's line (entr.a)
                    lbsr      EntrStep            a boss's entrance (entr.a): no input, the rest holds
                    bcc       sgp1
                    clr       <inp
                    clr       <ipress
                    lbra      Hero
sgp1                lbsr      Hero
                    lbsr      HatScore            a hat every 30,000 points (pickup.a)
                    lbsr      Signs               Ghost Town's hanging signs (ghost.a)
                    lbsr      RideStep            the Cattle Drive's ride (ride.a)
                    lbsr      TrainStep           the Train Heist's train (train.a)
                    lbsr      MissionStep         the Mission's doors, banners, dust (mission.a)
                    lbsr      NoonStep            High Noon's kicked stone (diamond.a)
                    tst       dying,u             (no wave while he's down)
                    bne       sgx
                    lbra      Waves
sg2                 cmpa      #PH.Ending          the ending's scene; it says when it's back to the title
                    bne       sg2e
                    lbsr      EndingStep
                    tst       endq,u
                    lbne      TitleInit
                    rts
sg2e                cmpa      #PH.Clear
                    bne       sg4
                    lbsr      HeroPassive         the taunt, then standing
                    ldd       <phaset
                    cmpd      #ClearT
                    blo       sgx
                    lda       stgn,u             a stage won: on to the next (health back up 6,
                    cmpa      #7                  lives and score kept, the weapon left behind);
                    bhs       sg3                 High Noon's next is the ending (7)
                    lda       <hhp
                    adda      #6
                    cmpa      #MaxHp
                    ble       sg2a
                    lda       #MaxHp
sg2a                sta       <hhp
                    clr       <hwep
                    clr       <hammo
                    lda       stgn,u
                    inca
                    lbra      StageInit
sg3                 lbsr      HiScore             TO BE CONTINUED: the title theme again
                    lda       #MU.title
                    lbsr      Music
                    lda       #PH.End
                    bra       SetPh
sg4                 cmpa      #PH.Over            game over: he topples, lies there
                    bne       sg4a
                    lbsr      HeroPassive
sg4a                ldd       <phaset             the end, game over: jump to go again
                    cmpd      #WaitT
                    blo       sgx
                    lda       <ipress
                    bita      #IN.Jump
                    beq       sgx
                    lbra      TitleInit           back to the title
sgx                 rts

* SetPh - A = the new phase
SetPh               sta       <phase
                    ldd       #0
                    std       <phaset
                    rts

********************************************************************
* Waves - walk right to trigger the next gang; clear it to get GO >>
********************************************************************
Waves               tst       <got
                    beq       wv0
                    dec       <got
wv0                 tst       <lock
                    beq       wv2
                    tst       <eleft              the wave's on until they're all KO'd
                    bne       wvx
                    clr       <lock
                    inc       <wavei
                    lda       #SF.Check
                    lbsr      Sfx
                    lda       <wavei
                    cmpa      nwaves,u
                    lbhs      StageClear
                    clr       siegt,u
                    lbsr      WaveRec             GO >> - unless the next is right here (the siege)
                    ldd       <cam
                    addd      #1
                    cmpd      ,x
                    bhs       wvx
                    lda       #GoLen
                    sta       <got
wvx                 rts
wv2                 lda       <wavei              the camera reaching the next wave's spot
                    cmpa      nwaves,u
                    bhs       wvx
                    lbsr      WaveRec
                    ldd       <cam
                    addd      #1
                    cmpd      ,x
                    blo       wvx
                    lda       <wavei              the same spot as the last (the siege): a breather
                    beq       wv3                 of 2.2 s first
                    pshs      x
                    dec       <wavei
                    lbsr      WaveRec
                    inc       <wavei
                    ldd       ,x
                    puls      x
                    cmpd      ,x
                    bne       wv3
                    inc       siegt,u
                    lda       siegt,u
                    cmpa      #132
                    blo       wvx
wv3                 equ       *
* StartWave - X = the wave: the screen locks there and the gang comes
StartWave           ldd       ,x++
                    std       <cam                the camera holds at the wave's spot
                    lslb
                    rola
                    lslb
                    rola
                    lslb
                    rola
                    lslb
                    rola
                    std       <camf
                    lda       #1
                    sta       <lock
                    lda       ,x+                 how many ($FF = the boss; +$80 = the siege: over the walls)
                    cmpa      #$FF                (then which: 0 Two-Bit, 1 Big Shell Dillon, 2 Doc Gila,
                    bne       swb9                3 Jack, 4 Sting, 5 Bullrush)
                    ldb       ,x
                    lbeq      StartBoss
                    decb
                    lbeq      StartDillon
                    decb
                    lbeq      StartGila
                    decb
                    lbeq      StartJack
                    decb
                    lbeq      StartSting
                    decb
                    lbeq      StartToro
                    lbra      StartDiamond
swb9                clr       <tmpk               (tmpk: the siege flag)
                    tsta
                    bpl       swb9a
                    anda      #$7F
                    inc       <tmpk
swb9a               sta       <tmpn
                    lda       <tmpk
                    pshs      a
                    clr       <tmpi               i
sw1                 pshs      x
                    lda       ,x                  the type
                    ldb       <tmpi
                    lbsr      Spawn               (X = it: OverWall checks there was room)
                    tst       2,s
                    beq       sw2
                    lda       <tmpi               the siege: over the wall, 0.45 s apart
                    lbsr      OverWall
sw2                 puls      x
                    leax      1,x
                    inc       <tmpi
                    dec       <tmpn
                    bne       sw1
                    puls      a
                    tsta
                    beq       sw3
                    lbsr      SiegeBell           the bell, HERE THEY COME! (mission.a)
sw3                 rts

* WaveRec - X = wave number wavei's record
WaveRec             ldx       stgp,u              this stage's table
                    ldd       SR.Waves,x
                    leax      StgTab,pcr
                    leax      d,x
                    ldb       <wavei
                    beq       wr2
wr1                 lda       2,x                 skip a record: cam, count, types
                    cmpa      #$FF
                    bne       wr1a
                    clra
wr1a                anda      #$7F                (the siege's flag)
                    leax      a,x
                    leax      3,x
                    decb
                    bne       wr1
wr2                 rts

* Spawn - A = the type, B = i: the i-th of a gang.  Skeletons rise out
*   of the ground on screen; the others walk in, even ones from the
*   right and odd ones from the left, two by two (brawler.js spawn)
Spawn               cmpa      #TY.Skel
                    lbeq      NewSkel
                    cmpa      #TY.SkelW
                    lbeq      NewSkelW
                    cmpa      #TY.Coy
                    lbeq      NewCoy
                    cmpa      #TY.Rat
                    lbeq      NewRat
                    lbra      NewDillo

* the waves: the camera's spot, how many, what (brawler.js STAGES.*.waves;
*   Boot Hill's 'skel@' rise out of the ground, Main Street's skeletons
*   walk in; $FF = the boss)
WaveBH              fdb       0
                    fcb       3,TY.Skel,TY.Dillo,TY.Skel
                    fdb       360
                    fcb       4,TY.Skel,TY.Skel,TY.Dillo,TY.Skel
                    fdb       760
                    fcb       4,TY.Dillo,TY.Skel,TY.Dillo,TY.Skel
                    fdb       1160
                    fcb       4,TY.Skel,TY.Skel,TY.Skel,TY.Skel
                    fdb       1600
                    fcb       $FF,0               Two-Bit
WaveMS              fdb       0
                    fcb       3,TY.Coy,TY.Coy,TY.Dillo
                    fdb       380
                    fcb       4,TY.Coy,TY.SkelW,TY.Coy,TY.Dillo
                    fdb       780
                    fcb       4,TY.SkelW,TY.Coy,TY.SkelW,TY.Dillo
                    fdb       1200
                    fcb       4,TY.Coy,TY.SkelW,TY.Coy,TY.SkelW
                    fdb       1660
                    fcb       6,TY.SkelW,TY.Coy,TY.SkelW,TY.Coy,TY.Coy,TY.SkelW
                    fdb       1700
                    fcb       $FF,1               Big Shell Dillon
WaveGT              fdb       0                   Ghost Town: the street, then the saloon
                    fcb       3,TY.Rat,TY.Coy,TY.SkelW
                    fdb       360
                    fcb       4,TY.Rat,TY.Coy,TY.Rat,TY.SkelW
                    fdb       720
                    fcb       4,TY.SkelW,TY.Rat,TY.Coy,TY.SkelW
                    fdb       1060
                    fcb       4,TY.Coy,TY.Rat,TY.Coy,TY.Rat
                    fdb       1360
                    fcb       6,TY.Rat,TY.SkelW,TY.Coy,TY.Rat,TY.Coy,TY.SkelW
                    fdb       1712
                    fcb       $FF,2               Doc Gila
WaveTH              fdb       0                   the Train Heist: along the roofs (no locked screen's edge over a gap)
                    fcb       3,TY.Coy,TY.Coy,TY.Rat
                    fdb       360
                    fcb       3,TY.Coy,TY.SkelW,TY.Coy
                    fdb       700
                    fcb       4,TY.Rat,TY.Coy,TY.SkelW,TY.Coy
                    fdb       1040
                    fcb       4,TY.SkelW,TY.Coy,TY.SkelW,TY.Rat
                    fdb       1370
                    fcb       5,TY.Coy,TY.SkelW,TY.Coy,TY.Rat,TY.Coy
                    fdb       1712
                    fcb       $FF,4               Sting
WaveMI              fdb       0                   the Mission: along the wall, then the siege in the courtyard (+$80)
                    fcb       3,TY.Coy,TY.Coy,TY.Rat
                    fdb       400
                    fcb       4,TY.SkelW,TY.Coy,TY.Coy,TY.Rat
                    fdb       960
                    fcb       $80+4,TY.Coy,TY.Coy,TY.Rat,TY.Coy
                    fdb       960
                    fcb       $80+5,TY.Coy,TY.SkelW,TY.Rat,TY.Coy,TY.Rat
                    fdb       960
                    fcb       $80+6,TY.Rat,TY.Coy,TY.SkelW,TY.Coy,TY.Dillo,TY.Coy
                    fdb       960
                    fcb       $80+6,TY.Coy,TY.Rat,TY.SkelW,TY.Coy,TY.Rat,TY.Dillo
                    fdb       960
                    fcb       $FF,5               Bullrush
WaveHN              fdb       0                   High Noon: down Main Street, then the duel at the clock tower
                    fcb       4,TY.Coy,TY.SkelW,TY.Rat,TY.Coy
                    fdb       420
                    fcb       5,TY.SkelW,TY.Coy,TY.Dillo,TY.Rat,TY.Coy
                    fdb       860
                    fcb       6,TY.Coy,TY.SkelW,TY.Coy,TY.Rat,TY.SkelW,TY.Coy
                    fdb       1280
                    fcb       $FF,6               Diamondback
WaveCD              fdb       1150                the Cattle Drive: on foot at the corral gate
                    fcb       4,TY.Coy,TY.Rat,TY.Coy,TY.SkelW
                    fdb       1712
                    fcb       $FF,3               Jackrabbit Jack

********************************************************************
* StageClear - the stage is won: he taunts
********************************************************************
StageClear          clr       <lock
                    lda       stgn,u              High Noon: no clear, on to the ending at once
                    cmpa      #6
                    bne       sc1
                    lda       #PH.Clear
                    lbsr      SetPh
                    ldd       #ClearT
                    std       <phaset
                    rts
sc1                 lda       #MU.clear
                    lbsr      Music
                    lda       #PH.Clear
                    lbsr      SetPh
                    ldd       #0
                    std       <hvx
                    std       <hvz
                    std       <hvh
                    std       <hh
                    lda       #ST.Taunt
                    lbra      SetS

* GameOver - the last life is gone
GameOver            lbsr      HiScore
                    lda       #MU.over
                    lbsr      Music
                    lda       #PH.Over
                    lbra      SetPh

********************************************************************
* AddScore - D = points.  A combo multiplies them: the hits landed
*   within 1.4 s of each other, up to eight (brawler.js addScore).
*   Exit: D = the points scored.  X and Y are kept.
********************************************************************
AddScore            pshs      x,y
                    std       <scw
                    lda       <combo
                    tst       <combot
                    bne       as1
                    clra
as1                 cmpa      #8
                    bhs       as2
                    inca
as2                 sta       <combo
                    sta       <scn
                    lda       #ComboLen
                    sta       <combot
                    ldd       #0                  points x the combo
as3                 addd      <scw
                    dec       <scn
                    bne       as3
                    std       <scw
                    bsr       AddBcd
                    ldd       <scw
                    puls      x,y,pc

* AddBcd - scw = points (binary, below 10000) added to the BCD score
AddBcd              ldd       <scw
                    std       <bcd                the remainder as it goes
                    ldx       #1000
                    bsr       Dig
                    lsla
                    lsla
                    lsla
                    lsla
                    sta       <scn
                    ldx       #100
                    bsr       Dig
                    ora       <scn
                    sta       <scn                thousands and hundreds
                    ldx       #10
                    bsr       Dig
                    lsla
                    lsla
                    lsla
                    lsla
                    ora       <bcd+1              tens and ones
                    adda      <score+3            add, low byte first
                    daa
                    sta       <score+3
                    lda       <score+2
                    adca      <scn
                    daa
                    sta       <score+2
                    lda       <score+1
                    adca      #0
                    daa
                    sta       <score+1
                    lda       <score
                    adca      #0
                    daa
                    sta       <score
                    rts

* Dig - X = a power of ten: A = bcd / X, bcd = the remainder
Dig                 pshs      x
                    clr       <scd
                    ldd       <bcd
dg1                 cmpd      ,s
                    blo       dg2
                    subd      ,s
                    inc       <scd
                    bra       dg1
dg2                 std       <bcd
                    lda       <scd
                    puls      x,pc
